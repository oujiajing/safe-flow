# Copy to .env.portfolio-demo and replace every placeholder with unique local secrets.
POSTGRES_DB=portfolio_demo
POSTGRES_USER=portfolio_demo_app
POSTGRES_PASSWORD=YOUR_DB_PASSWORD_HERE
POSTGRES_PORT=15434
MINIO_ROOT_USER=portfolio-demo
MINIO_ROOT_PASSWORD=YOUR_MINIO_SECRET_KEY_HERE
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
PINGAN_DB_URL=jdbc:postgresql://localhost:15434/portfolio_demo
PINGAN_DB_USERNAME=portfolio_demo_app
PINGAN_JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_BYTES_HERE
PINGAN_DB_PASSWORD=YOUR_DB_PASSWORD_HERE
PINGAN_STORAGE_PROVIDER=local
PINGAN_MINIO_ENDPOINT=http://localhost:19000
PINGAN_MINIO_BUCKET=portfolio-demo-assets
PINGAN_MINIO_ACCESS_KEY=portfolio-demo
PINGAN_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY_HERE
