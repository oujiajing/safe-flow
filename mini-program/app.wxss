page {
  --pingan-tabbar-content-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: #f4f6f8;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  padding: 22rpx;
  padding-bottom: var(--pingan-tabbar-content-bottom);
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.5;
  max-width: 100%;
  overflow-x: hidden;
}

view,
scroll-view,
swiper,
button,
input,
textarea,
picker,
image {
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

button,
input,
textarea {
  min-height: 1rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 51, 0.06);
}

.muted {
  color: #697386;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
}

.primary-button {
  min-width: 104rpx;
  max-width: 192rpx;
  height: 52rpx;
  line-height: 50rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #1f9d67;
  font-size: 24rpx;
  font-weight: 900;
  padding: 0 20rpx;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  width: auto;
  min-width: 104rpx;
  max-width: 192rpx;
  height: 52rpx;
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 50rpx;
  font-weight: 900;
  white-space: nowrap;
  box-sizing: border-box;
}
