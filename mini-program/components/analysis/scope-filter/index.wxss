.scope-card{height:116rpx;padding:18rpx 22rpx;border-radius:18rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(15,42,31,.08);display:flex;align-items:center;gap:16rpx;box-sizing:border-box}.scope-card--compact{height:82rpx;padding:0 28rpx;justify-content:space-between;border-radius:16rpx}.scope-compact-label{color:#172033;font-size:27rpx;font-weight:600}.scope-compact-value{display:flex;align-items:center;gap:10rpx;color:#172033;font-size:27rpx}.scope-icon{width:62rpx;height:62rpx;border-radius:50%;background:#e8f7f0;display:flex;align-items:center;justify-content:center;flex:0 0 62rpx}.scope-company-icon{display:block;width:42rpx;height:42rpx}.scope-copy{flex:1;min-width:0}.scope-org{font-size:29rpx;font-weight:800;color:#172033;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.scope-range{margin-top:7rpx;font-size:21rpx;color:#4b5563;white-space:nowrap}.scope-action{height:70rpx;padding-left:22rpx;border-left:1rpx solid #e1e5e9;display:flex;align-items:center;gap:8rpx;color:#078249;font-size:25rpx;white-space:nowrap}.filter-mask{position:fixed;z-index:1100;inset:0;background:rgba(15,23,42,.45)}.filter-drawer{position:fixed;z-index:1101;left:0;right:0;bottom:0;max-height:calc(100vh - 80rpx);overflow-y:auto;padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0;background:#fff;box-sizing:border-box}.filter-drawer--tabbar{bottom:104rpx;padding-bottom:calc(30rpx + env(safe-area-inset-bottom))}.filter-head{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:800;color:#172033}.filter-field{margin-top:30rpx}.filter-label{display:block;margin-bottom:14rpx;font-size:24rpx;color:#64748b}.filter-org-field picker+picker{display:block;margin-top:16rpx}.filter-input,.date-input{height:82rpx;padding:0 22rpx;border:2rpx solid #e2e8f0;border-radius:16rpx;display:flex;align-items:center;justify-content:space-between;font-size:27rpx;color:#1e293b;box-sizing:border-box}.filter-input--fixed{background:#f8fafc}.filter-level{width:76rpx;color:#64748b;font-size:24rpx}.filter-value{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.filter-fixed-tag{padding:6rpx 12rpx;border-radius:999rpx;background:#e7f7ef;color:#078249;font-size:21rpx}.quick-list{display:flex;gap:16rpx}.quick-item{flex:1;height:68rpx;border-radius:14rpx;background:#f3f6f8;display:flex;align-items:center;justify-content:center;color:#475569;font-size:25rpx}.quick-item.active{background:#e7f7ef;color:#078249;font-weight:700}.date-row{margin-top:22rpx;display:flex;align-items:center;gap:14rpx;color:#94a3b8}.date-row picker{flex:1}.date-input{justify-content:center;padding:0;font-size:24rpx}.filter-actions{position:relative;z-index:1;display:flex;gap:18rpx;margin-top:36rpx}.filter-actions button{flex:1;margin:0;height:82rpx;padding:0;line-height:normal;border-radius:16rpx;font-size:28rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}.filter-reset{background:#f1f5f9;color:#475569}.filter-apply{background:#078249;color:#fff;font-weight:700}
