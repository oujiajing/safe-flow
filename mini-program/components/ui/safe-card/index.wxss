.safe-card {
  width: 100%;
  min-height: var(--safe-card-min-height, 0);
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(229, 232, 239, 0.86);
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.safe-card--compact {
  padding: 22rpx 24rpx;
}

.safe-card--elevated {
  box-shadow: 0 8rpx 28rpx rgba(20, 35, 55, 0.08);
}
