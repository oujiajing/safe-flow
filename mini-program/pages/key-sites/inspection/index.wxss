@import "../common.wxss";
.ks-site-banner { margin-bottom: 20rpx; padding: 24rpx; display: flex; align-items: center; gap: 22rpx; border: 1rpx solid #e4e9ef; border-radius: 16rpx; background: #fff; }
.ks-site-mark { width: 88rpx; height: 88rpx; border-radius: 14rpx; background: #0878f9; color: #fff; font-size: 24rpx; font-weight: 800; line-height: 88rpx; text-align: center; }
.ks-site-banner view:last-child { display: flex; flex-direction: column; gap: 8rpx; }.ks-site-banner view:last-child text:first-child { font-size: 32rpx; font-weight: 800; }.ks-site-banner view:last-child text:last-child { color: #667085; font-size: 24rpx; }
.ks-progress-card { margin-bottom: 20rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #fff; }.ks-progress-card view { margin-bottom: 16rpx; display: flex; justify-content: space-between; font-size: 26rpx; }.ks-progress-card view text:last-child { color: #0878f9; font-weight: 800; }
.ks-inspection-card { margin-bottom: 20rpx; padding: 26rpx; border: 1rpx solid #e4e9ef; border-radius: 16rpx; background: #fff; }
.ks-question { display: grid; grid-template-columns: 52rpx 1fr 20rpx; gap: 10rpx; align-items: start; font-size: 28rpx; font-weight: 700; line-height: 42rpx; }.ks-index { width: 46rpx; height: 46rpx; border-radius: 50%; background: #0878f9; color: #fff; line-height: 46rpx; text-align: center; }.ks-star, .ks-field-title text { color: #ef3434; }
.ks-result-grid { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.ks-result { height: 70rpx; border: 2rpx solid #dfe4ea; border-radius: 10rpx; line-height: 70rpx; text-align: center; }.ks-result.safe.active { border-color: #20a564; background: #f0fbf6; color: #168c55; }.ks-result.danger.active { border-color: #ff7a3d; background: #fff5ef; color: #eb541c; }
.ks-field-title { margin: 24rpx 0 14rpx; font-size: 27rpx; font-weight: 700; }.ks-inspection-card textarea { width: 100%; height: 132rpx; padding: 18rpx; border: 1rpx solid #dce2ea; border-radius: 10rpx; font-size: 26rpx; }
.ks-upload { width: 100%; height: 180rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; border: 2rpx dashed #c8d0db; border-radius: 12rpx; color: #667085; font-size: 24rpx; overflow: hidden; }.ks-upload image { width: 100%; height: 100%; }.ks-camera { color: #0878f9; font-size: 28rpx; font-weight: 800; }
.ks-bottom-one { grid-template-columns: 1fr; }
