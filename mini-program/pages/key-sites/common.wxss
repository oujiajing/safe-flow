page { background: #f5f6f8; color: #1d2129; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.ks-page { min-height: 100vh; padding: 24rpx 24rpx 168rpx; box-sizing: border-box; }
.ks-card { margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #e9ebef; border-radius: 18rpx; background: #fff; box-shadow: 0 6rpx 20rpx rgba(23, 43, 77, .045); }
.ks-section-title { margin-bottom: 24rpx; padding-left: 18rpx; position: relative; font-size: 30rpx; font-weight: 700; line-height: 40rpx; }
.ks-section-title::before { content: ""; width: 7rpx; position: absolute; left: 0; top: 3rpx; bottom: 3rpx; border-radius: 8rpx; background: #1677ff; }
.ks-primary, .ks-outline { width: 100% !important; min-width: 0 !important; max-width: none !important; height: 88rpx; min-height: 88rpx; margin: 0 !important; padding: 0 !important; box-sizing: border-box; border-radius: 10rpx; font-size: 30rpx; font-weight: 600; line-height: 88rpx; }
.ks-primary { background: #1677ff; color: #fff; }
.ks-outline { border: 2rpx solid #1677ff; background: #fff; color: #1677ff; }
.ks-primary::after, .ks-outline::after { border: 0; }
.ks-bottom { padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1.15fr; gap: 20rpx; position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #e6e8eb; }
.ks-error { margin: 18rpx 0; padding: 18rpx 22rpx; border-radius: 12rpx; background: #fff2ed; color: #d9480f; font-size: 26rpx; }
.ks-empty { padding: 100rpx 20rpx; color: #8b95a5; text-align: center; }
.ks-media-viewer { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.94); }
.ks-media-viewer-close { width: 64rpx; height: 64rpx; position: absolute; z-index: 2; top: calc(28rpx + env(safe-area-inset-top)); right: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.16); }
.ks-media-viewer-video { width: 100vw; height: 56.25vw; max-height: 100vh; background: #000; }
.ks-row { min-height: 104rpx; display: grid; grid-template-columns: 190rpx 1fr 36rpx; align-items: center; border-bottom: 1rpx solid #eceef1; font-size: 28rpx; }
.ks-row:last-child { border-bottom: 0; }
.ks-required::before { content: "*"; margin-right: 8rpx; color: #ef3434; }
.ks-value, .ks-row input { color: #8c939f; text-align: right; }
.ks-row input { width: 100%; height: 72rpx; font-size: 28rpx; }
.ks-arrow { color: #9ca5b2; font-size: 38rpx; text-align: right; }
