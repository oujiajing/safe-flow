page {
  background: #f8f9fb;
}

.login-page {
  position: relative;
  min-height: 100vh;
  padding: 0 38rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
  color: #252832;
}

.login-background-image {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.login-content {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 680rpx;
  margin: 0 auto;
  padding-top: calc(148rpx + env(safe-area-inset-top));
}

.brand-section {
  text-align: center;
}

.brand-logo {
  display: block;
  width: 420rpx;
  margin: 0 auto;
}

.brand-welcome {
  margin-top: 24rpx;
  color: #202431;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.brand-tagline {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  color: #81848b;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.brand-tagline__dot {
  margin: 0 12rpx;
  color: #b6b9bf;
}

.login-form {
  position: relative;
  margin-top: 48rpx;
  padding: 54rpx 48rpx 40rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 64rpx rgba(32, 41, 58, 0.1);
}

.login-field {
  display: flex;
  align-items: center;
  height: 102rpx;
  border-bottom: 1rpx solid #e2e3e7;
}

.login-field + .login-field {
  margin-top: 12rpx;
}

.login-input {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  margin-left: 28rpx;
  padding: 0;
  box-sizing: border-box;
  color: #252832;
  font-size: 30rpx;
}

.login-placeholder {
  color: #9a9ca2;
}

.password-toggle {
  flex: none;
  padding: 12rpx 0 12rpx 18rpx;
}

.login-button {
  width: 584rpx;
  min-width: 584rpx;
  max-width: 100%;
  height: 92rpx;
  margin-top: 42rpx;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 48rpx;
  background: #dd0716;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 92rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 13rpx 28rpx rgba(221, 7, 22, 0.2);
}

.login-button::after {
  border: 0;
}

.login-button[disabled] {
  background: #e17f87;
  box-shadow: none;
}

.login-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
  color: #45484f;
  font-size: 26rpx;
}

.login-link {
  flex: 1;
  text-align: center;
}

.login-link + .login-link {
  border-left: 1rpx solid #e0e2e6;
}

.login-link--accent {
  color: #dd0716;
}

.more-login {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 42rpx;
  color: #555860;
  font-size: 26rpx;
  white-space: nowrap;
}

.more-login__line {
  flex: 1;
  border-top: 1rpx dashed #d9dbe0;
}

.more-login__label {
  display: flex;
  align-items: center;
  gap: 5rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 38rpx;
  color: #62656d;
  font-size: 24rpx;
  line-height: 1.7;
}

.agreement-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin-right: 16rpx;
  border: 2rpx solid #c2c4c9;
  border-radius: 50%;
  box-sizing: border-box;
}

.agreement-check--checked {
  border-color: #dd0716;
  background: #dd0716;
}

.agreement-link {
  color: #dd0716;
}

.login-footer {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-top: 104rpx;
  color: #70747c;
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.login-footer__line {
  width: 66rpx;
  border-top: 1rpx solid #8f939a;
}

@media (max-height: 720px) {
  .login-content {
    padding-top: calc(78rpx + env(safe-area-inset-top));
  }

  .brand-logo {
    width: 340rpx;
  }

  .brand-welcome {
    margin-top: 16rpx;
    font-size: 34rpx;
  }

  .login-form {
    margin-top: 26rpx;
    padding-top: 40rpx;
  }

  .login-footer {
    margin-top: 54rpx;
  }
}
