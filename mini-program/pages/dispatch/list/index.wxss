page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f4f6f8;
}

.page {
  min-height: 100vh;
  padding: 0;
  max-width: none;
  overflow-x: hidden;
  background: #f4f6f8;
  color: #202a37;
}

.dispatch-report-page {
  min-height: 100vh;
  padding: 0 0 48rpx;
  box-sizing: border-box;
  background: #f4f6f8;
}

.dispatch-tabs {
  width: 100%;
  height: 110rpx;
  margin-left: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: end;
  column-gap: 0;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf1;
  box-sizing: border-box;
}

.dispatch-tab {
  position: relative;
  height: 76rpx;
  color: #222833;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
}

.dispatch-tab.active {
  color: #078249;
  font-weight: 900;
}

.dispatch-tab.active::after {
  content: "";
  width: 82rpx;
  height: 6rpx;
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: #078249;
}

.dispatch-filter-row {
  width: 100%;
  min-height: 102rpx;
  padding: 0 28rpx 0 36rpx;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: center;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf1;
  box-sizing: border-box;
}

.dispatch-filter-trigger,
.dispatch-create-link,
.dispatch-filter-date {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
  color: #078249;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.dispatch-filter-date {
  justify-content: center;
  color: #667085;
  font-size: 23rpx;
  font-weight: 600;
}

.dispatch-filter-date text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dispatch-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin: 22rpx 24rpx;
}

.dispatch-summary-card {
  min-width: 0;
  padding: 18rpx 10rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20, 84, 67, 0.06);
  text-align: center;
}

.dispatch-summary-card text {
  display: block;
  color: #6b7f77;
  font-size: 21rpx;
  line-height: 28rpx;
}

.dispatch-summary-card strong {
  display: block;
  margin-top: 8rpx;
  color: #078249;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.dispatch-summary-card.pending strong {
  color: #d97706;
}

.dispatch-summary-card.blue strong {
  color: #1677ff;
}

.dispatch-task-list {
  padding: 0 0 0;
  background: #f4f6f8;
}

.dispatch-action-message {
  margin: 0 24rpx 22rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 8rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 25rpx;
  line-height: 36rpx;
}

.dispatch-reference-card {
  display: block;
  margin-bottom: 20rpx;
}

.dispatch-reference-card safe-card,
.dispatch-task-list safe-card {
  display: block;
}

.dispatch-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.dispatch-field-row {
  min-height: 48rpx;
  margin-bottom: 18rpx;
  display: grid;
  grid-template-columns: 40rpx minmax(0, 1fr);
  column-gap: 14rpx;
  align-items: center;
  color: #202a37;
  font-size: 28rpx;
  line-height: 40rpx;
}

.dispatch-field-row--content {
  margin-bottom: 22rpx;
}

.dispatch-field-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dispatch-row-icon,
.dispatch-filter-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dispatch-status-pill {
  min-width: 112rpx;
  padding: 12rpx 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fff1e5;
  color: #ea580c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 32rpx;
  white-space: nowrap;
}

.dispatch-status-pill.done {
  background: #078249;
  color: #ffffff;
}

.dispatch-status-pill.withdrawn {
  background: #f1f5f9;
  color: #64748b;
}

.dispatch-actions {
  padding-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 30rpx;
  border-top: 1rpx solid #e5e8ec;
}

.dispatch-action-btn {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 62rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.dispatch-outline-green {
  border: 2rpx solid #078249;
  background: #ffffff;
  color: #078249;
}

.dispatch-primary-btn {
  border: 2rpx solid #078249;
  background: #078249;
  color: #ffffff;
}

.dispatch-filter-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.16);
}

.dispatch-filter-drawer {
  width: 620rpx;
  height: 100vh;
  padding: 30rpx 28rpx 0;
  position: fixed;
  top: 0;
  right: 0;
  z-index: 21;
  background: #ffffff;
  box-shadow: -8rpx 0 24rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
}

.dispatch-filter-title {
  height: 58rpx;
  margin-bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #202a37;
  font-size: 32rpx;
  font-weight: 900;
}

.dispatch-filter-close {
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #94a3b8;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 54rpx;
}

.dispatch-filter-close::after {
  border: 0;
}

.dispatch-filter-field {
  min-height: 68rpx;
  margin-bottom: 20rpx;
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
  color: #202a37;
  font-size: 26rpx;
  font-weight: 800;
}

.dispatch-date-input {
  height: 60rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce3ea;
  border-radius: 6rpx;
  background: #ffffff;
  color: #5b6472;
  font-size: 25rpx;
  line-height: 58rpx;
  box-sizing: border-box;
}

.dispatch-filter-submit {
  width: 150rpx;
  height: 64rpx;
  margin: 38rpx 0 0 auto;
  padding: 0;
  border-radius: 999rpx;
  background: #078249;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.dispatch-filter-submit::after {
  border: 0;
}

.dispatch-table-scroll {
  margin: 0 24rpx;
}
