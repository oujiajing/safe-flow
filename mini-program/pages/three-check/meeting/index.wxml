<view class="page">
  <view class="meeting-page">
    <block wx:if="{{meetingMode === 'list'}}">
      <green-header title="班前会" bind:back="goBack" />

      <view class="meeting-tabs">
        <view class="meeting-tab {{meetingListTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="changeMeetingListTab">待开会议 ({{tabCounts.pending}})</view>
        <view class="meeting-tab {{meetingListTab === 'done' ? 'active' : ''}}" data-tab="done" bindtap="changeMeetingListTab">已开会议 ({{tabCounts.done}})</view>
        <view class="meeting-tab {{meetingListTab === 'expired' ? 'active' : ''}}" data-tab="expired" bindtap="changeMeetingListTab">已逾期 ({{tabCounts.expired}})</view>
      </view>

      <view class="meeting-filter-row">
        <view class="meeting-filter-trigger" bindtap="openMeetingFilter">
          <t-icon t-class="meeting-filter-icon" name="filter" size="44rpx" color="#078249" />
          <text>筛选</text>
        </view>
      </view>

      <view class="meeting-task-list">
        <view wx:if="{{actionMessage}}" class="meeting-action-message">{{actionMessage}}</view>
        <state-view wx:if="{{loading}}" loading="{{true}}" loadingText="正在加载班前会" />
        <state-view wx:elif="{{errorText}}" errorText="{{errorText}}" bind:retry="loadMeetings" />
        <block wx:elif="{{meetingRows.length > 0}}">
          <safe-card wx:for="{{meetingRows}}" wx:key="id" compact="{{true}}" elevated="{{true}}" data-id="{{item.id}}" bindtap="openMeetingDetail" class="meeting-reference-card">
            <view class="meeting-card-head">
              <view class="meeting-field-row meeting-field-row--date">
                <t-icon t-class="meeting-row-icon" name="calendar" size="34rpx" color="#078249" />
                <text class="meeting-field-value">{{item.date}}</text>
              </view>
              <text class="meeting-status-pill {{item.statusClass}} {{item.status === '已提交' ? 'done' : ''}}">{{item.status}}</text>
            </view>
            <view class="meeting-field-row meeting-field-row--team">
              <t-icon t-class="meeting-row-icon" name="building" size="34rpx" color="#078249" />
              <text class="meeting-field-value">{{item.dept}}　{{item.team}}</text>
            </view>
            <view class="meeting-field-row meeting-field-row--owner">
              <t-icon t-class="meeting-row-icon" name="user" size="34rpx" color="#078249" />
              <text class="meeting-field-value">{{item.owner}}</text>
            </view>
            <view class="meeting-field-row meeting-field-row--content">
              <t-icon t-class="meeting-row-icon" name="file-paste" size="34rpx" color="#078249" />
              <text class="meeting-field-value">{{item.task}}</text>
            </view>
            <view class="meeting-actions">
              <view class="meeting-action-btn meeting-outline-green" data-id="{{item.id}}" catchtap="openMeetingDetail">明细</view>
              <view wx:if="{{canSubmitAction && item.canSubmit}}" class="meeting-action-btn meeting-primary-btn" data-id="{{item.id}}" catchtap="submitMeeting">提交</view>
              <view wx:if="{{canWithdrawAction && item.canWithdraw}}" class="meeting-action-btn meeting-outline-blue" data-id="{{item.id}}" catchtap="withdrawMeeting">撤回</view>
              <view wx:if="{{canRemindAction && item.canRemind}}" class="meeting-action-btn meeting-outline-green" data-id="{{item.id}}" catchtap="remindMeeting">催一下</view>
            </view>
          </safe-card>
        </block>
        <state-view wx:else empty="{{true}}" emptyText="没有更多了" />
      </view>

      <block wx:if="{{showMeetingFilter}}">
        <view class="meeting-filter-mask" bindtap="closeMeetingFilter"></view>
        <view class="meeting-filter-drawer">
          <view class="meeting-filter-title"><text>过滤条件</text><button class="meeting-filter-close" bindtap="closeMeetingFilter">×</button></view>
          <view class="meeting-filter-field">
            <text>开始日期</text>
            <picker mode="date" value="{{meetingDateStart}}" data-field="dateStart" bindchange="changeMeetingFilterDate">
              <view class="meeting-date-input">{{meetingDateStart}}</view>
            </picker>
          </view>
          <view class="meeting-filter-field">
            <text>结束日期</text>
            <picker mode="date" value="{{meetingDateEnd}}" data-field="dateEnd" bindchange="changeMeetingFilterDate">
              <view class="meeting-date-input">{{meetingDateEnd}}</view>
            </picker>
          </view>
          <button class="meeting-filter-submit" bindtap="applyMeetingFilter">筛选</button>
        </view>
      </block>
    </block>
  </view>
</view>
