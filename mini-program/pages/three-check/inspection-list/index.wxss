page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f4f6f8;
}

.page {
  min-height: 100vh;
  padding: 0;
  max-width: none;
  overflow-x: hidden;
  background: #f4f6f8;
  color: #202a37;
}

.inspection-page {
  min-height: 100vh;
  padding-bottom: 38rpx;
  background: #f4f6f8;
}

.inspection-tabs {
  width: calc(100vw + 2rpx);
  max-width: none;
  height: 110rpx;
  margin-left: calc(50% - 50vw);
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: end;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf1;
  box-sizing: border-box;
}

.inspection-tab {
  height: 76rpx;
  position: relative;
  color: #222833;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
}

.inspection-tab.active {
  color: #078249;
  font-weight: 900;
}

.inspection-tab.active::after {
  content: "";
  width: 82rpx;
  height: 6rpx;
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: #078249;
}

.inspection-filter-row {
  width: calc(100vw + 2rpx);
  max-width: none;
  height: 102rpx;
  margin-left: calc(50% - 50vw);
  padding: 0 0 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf1;
  box-sizing: border-box;
}

.inspection-filter-trigger {
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  color: #078249;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.inspection-filter-icon,
.inspection-row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.inspection-task-list {
  padding: 22rpx 0 0;
  background: #f4f6f8;
}

.inspection-action-message {
  margin: 0 28rpx 22rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 25rpx;
  line-height: 36rpx;
}

.inspection-reference-card {
  display: block;
  margin-bottom: 20rpx;
}

.inspection-reference-card safe-card,
.inspection-task-list safe-card {
  display: block;
}

.inspection-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.inspection-field-row {
  min-height: 48rpx;
  margin-bottom: 18rpx;
  display: grid;
  grid-template-columns: 40rpx minmax(0, 1fr);
  column-gap: 14rpx;
  align-items: center;
  color: #202a37;
  font-size: 28rpx;
  line-height: 40rpx;
}

.inspection-field-row--content {
  margin-bottom: 22rpx;
}

.inspection-field-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inspection-row-icon {
  width: 34rpx;
  height: 34rpx;
}

.inspection-status-pill {
  min-width: 112rpx;
  padding: 10rpx 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #fff1e5;
  color: #ea580c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 32rpx;
  white-space: nowrap;
}

.inspection-status-pill.done,
.inspection-status-pill.opened {
  background: #078249;
  color: #ffffff;
}

.inspection-status-pill.pending {
  background: #fff1e5;
  color: #ea580c;
}

.inspection-actions {
  padding-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 30rpx;
  border-top: 1rpx solid #e5e8ec;
}

.inspection-actions.has-rectify {
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 16rpx;
}

.inspection-action-btn {
  min-width: 0;
  height: 62rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 62rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.inspection-actions.has-rectify .inspection-action-btn {
  font-size: 24rpx;
}

.inspection-outline-green {
  border: 2rpx solid #078249;
  background: #ffffff;
  color: #078249;
}

.inspection-outline-blue {
  border: 2rpx solid #1683ff;
  background: #ffffff;
  color: #1683ff;
}

.inspection-outline-orange {
  border: 2rpx solid #f97316;
  background: #ffffff;
  color: #ea580c;
}

.inspection-primary-btn {
  border: 2rpx solid #078249;
  background: #078249;
  color: #ffffff;
}

.inspection-filter-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.16);
}

.inspection-filter-drawer {
  width: 620rpx;
  height: 100vh;
  padding: 30rpx 28rpx 0;
  position: fixed;
  top: 0;
  right: 0;
  z-index: 21;
  background: #ffffff;
  box-shadow: -8rpx 0 24rpx rgba(15, 23, 42, 0.12);
  box-sizing: border-box;
}

.inspection-filter-title {
  height: 58rpx;
  margin-bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #202a37;
  font-size: 32rpx;
  font-weight: 900;
}

.inspection-filter-close {
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #94a3b8;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 54rpx;
}

.inspection-filter-close::after {
  border: 0;
}

.inspection-filter-field {
  min-height: 68rpx;
  margin-bottom: 20rpx;
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
  color: #202a37;
  font-size: 26rpx;
  font-weight: 800;
}

.inspection-date-input {
  height: 60rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce3ea;
  border-radius: 6rpx;
  background: #ffffff;
  color: #5b6472;
  font-size: 25rpx;
  line-height: 58rpx;
  box-sizing: border-box;
}

.inspection-filter-submit {
  width: 150rpx;
  height: 64rpx;
  margin: 38rpx 0 0 auto;
  padding: 0;
  border-radius: 999rpx;
  background: #078249;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.inspection-filter-submit::after {
  border: 0;
}
