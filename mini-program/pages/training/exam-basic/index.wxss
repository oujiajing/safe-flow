page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f5f7fb;
  color: #172033;
}

.exam-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 40rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.exam-detail-toolbar {
  min-height: 104rpx;
  padding: 20rpx 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.exam-back-btn {
  width: 126rpx;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #b8dec9;
  border-radius: 16rpx;
  background: #ffffff;
  color: #078249;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 60rpx;
  box-sizing: border-box;
}

.exam-toolbar-actions {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
}

.exam-draft-btn {
  width: 136rpx;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #d8dde5;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 60rpx;
  box-sizing: border-box;
}

.exam-submit-btn {
  width: 136rpx;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #078249;
  border-radius: 16rpx;
  background: #078249;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 60rpx;
  box-sizing: border-box;
}

.exam-detail-tabs {
  height: 96rpx;
  display: grid;
  grid-template-columns: max-content max-content;
  align-items: flex-end;
  gap: 86rpx;
  border-bottom: 1rpx solid #dfe5eb;
  box-sizing: border-box;
}

.exam-detail-tab {
  position: relative;
  height: 80rpx;
  color: #656d78;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 68rpx;
  white-space: nowrap;
}

.exam-detail-tab.active {
  color: #078249;
  font-weight: 900;
}

.exam-detail-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 92rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #078249;
  content: "";
  transform: translateX(-50%);
}

.exam-info-card {
  margin-top: 18rpx;
  padding: 0 26rpx;
  border: 1rpx solid #edf1f5;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(16, 24, 40, 0.08);
  box-sizing: border-box;
}

.exam-info-row {
  min-height: 116rpx;
  display: grid;
  grid-template-columns: 58rpx 190rpx minmax(0, 1fr);
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #e6ebf0;
  box-sizing: border-box;
}

.exam-info-row:last-child {
  border-bottom: none;
}

.exam-info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-info-label {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 900;
  white-space: nowrap;
}

.required {
  color: #ff2d20;
  font-size: 30rpx;
  font-weight: 900;
}

.exam-info-value {
  min-width: 0;
  color: #202733;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 46rpx;
  overflow-wrap: anywhere;
}

.exam-status-pill {
  min-width: 104rpx;
  height: 54rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border: 1rpx solid #bde5cc;
  border-radius: 16rpx;
  background: #eaf8f0;
  color: #078249;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
  box-sizing: border-box;
}

.exam-question-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 14rpx;
}

.exam-question-card {
  min-height: 66rpx;
  padding: 0 18rpx;
  border: 1rpx solid #edf1f5;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.08);
  box-sizing: border-box;
}

.exam-question-card.expanded {
  padding-bottom: 18rpx;
}

.exam-question-head {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.exam-question-title {
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  color: #172033;
  font-size: 24rpx;
  font-weight: 900;
}

.exam-question-no {
  width: 38rpx;
  height: 38rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1689ff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.exam-question-body {
  padding: 12rpx 0 0;
  border: 1rpx solid #e7ebf0;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.exam-question-row {
  min-height: 50rpx;
  display: grid;
  grid-template-columns: 100rpx minmax(0, 1fr);
  align-items: start;
  gap: 22rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.option-row {
  padding-bottom: 14rpx;
}

.exam-question-label {
  color: #303846;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.exam-question-value {
  min-width: 0;
  color: #202733;
  font-size: 22rpx;
  line-height: 42rpx;
  overflow-wrap: anywhere;
}

.exam-question-link {
  color: #1689ff;
  font-weight: 900;
}

.exam-options {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.exam-option {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border: 1rpx solid #e7ebf0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #303846;
  font-size: 22rpx;
  line-height: 34rpx;
  box-sizing: border-box;
}
