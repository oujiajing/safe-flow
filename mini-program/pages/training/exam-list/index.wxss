page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f5f7fb;
  color: #172033;
}

.exam-page {
  min-height: 100vh;
  padding: 0 0 36rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.exam-search-row {
  height: 62rpx;
  display: grid;
  grid-template-columns: 46rpx minmax(0, 1fr) 82rpx;
  align-items: center;
  gap: 8rpx;
  margin: 20rpx 30rpx 14rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-search-input {
  min-width: 0;
  height: 60rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 60rpx;
}

.exam-search-submit {
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #078249;
  border-radius: 999rpx;
  background: #eef8f2;
  color: #078249;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.exam-toolbar {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx 6rpx;
  border-bottom: 1rpx solid #e7ebf0;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-create-btn {
  width: 148rpx;
  min-width: 148rpx;
  height: 50rpx;
  display: inline-flex;
  align-self: center;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #08a85c;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 50rpx;
  box-shadow: 0 8rpx 18rpx rgba(8, 168, 92, 0.22);
  box-sizing: border-box;
}

.exam-create-label {
  flex: 0 0 auto;
  white-space: nowrap;
}

.exam-filter-btn {
  width: 116rpx;
  min-width: 116rpx;
  height: 50rpx;
  display: inline-flex;
  align-self: center;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #172033;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 50rpx;
  box-sizing: border-box;
}

.exam-filter-panel {
  padding: 24rpx 30rpx 26rpx;
  border-bottom: 1rpx solid #e7ebf0;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-filter-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.exam-filter-close {
  width: 48rpx;
  height: 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #59616d;
  font-size: 40rpx;
  line-height: 48rpx;
}

.exam-filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.exam-filter-field {
  min-width: 0;
}

.exam-filter-label {
  display: block;
  margin-bottom: 10rpx;
  color: #59616d;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.exam-filter-value {
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  padding: 0 14rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 16rpx;
  background: #ffffff;
  color: #172033;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
  box-sizing: border-box;
}

.exam-filter-value text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exam-filter-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.exam-filter-action {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cfd8e3;
  border-radius: 999rpx;
  background: #ffffff;
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 62rpx;
  box-sizing: border-box;
}

.exam-filter-action.primary {
  border-color: #078249;
  background: #078249;
  color: #ffffff;
}

.exam-status-tabs {
  width: 100%;
  height: 86rpx;
  margin: 0;
  overflow: hidden;
  border: 1rpx solid #e7ebf0;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-status-tab-list {
  height: 86rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: 0;
  padding: 0;
  box-sizing: border-box;
}

.exam-status-tab {
  position: relative;
  height: 70rpx;
  color: #59616d;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
}

.exam-status-tab.active {
  color: #078249;
  font-weight: 900;
}

.exam-status-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 88rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #078249;
  content: "";
  transform: translateX(-50%);
}

.exam-card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 14rpx 30rpx 0;
  box-sizing: border-box;
}

.exam-card {
  min-height: 188rpx;
  padding: 28rpx 26rpx 22rpx;
  border: 1rpx solid #edf1f5;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.09);
  box-sizing: border-box;
}

.exam-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.exam-card-company {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exam-card-status {
  flex: 0 0 auto;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4e8;
  color: #d66700;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.exam-card-status.done {
  background: #e8f7ef;
  color: #078249;
}

.exam-card-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #454c57;
  font-size: 28rpx;
  line-height: 36rpx;
}

.exam-meta-item {
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  white-space: nowrap;
}

.exam-name {
  flex: 1 1 auto;
}

.exam-meta-item text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exam-meta-divider {
  width: 1rpx;
  height: 32rpx;
  background: #d9dee6;
  flex: 0 0 1rpx;
}

.exam-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
}

.exam-person-pill {
  flex: 1 1 auto;
  max-width: 330rpx;
  min-width: 110rpx;
  height: 52rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef8f2;
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.exam-person-pill text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exam-card-actions {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.exam-detail-btn {
  width: 98rpx;
  min-width: 98rpx;
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 2rpx solid #078249;
  border-radius: 999rpx;
  background: #ffffff;
  color: #078249;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 44rpx;
  box-sizing: border-box;
}

.exam-start-btn {
  min-width: 112rpx;
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #078249;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 46rpx;
  box-sizing: border-box;
}
