page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f5f7fb;
  color: #172033;
}

.exam-create-page {
  min-height: 100vh;
  padding: 0 28rpx 48rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}

.exam-create-toolbar {
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.exam-create-toolbar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.exam-create-back-btn {
  width: 136rpx;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #d8dde5;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.08);
  color: #172033;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 60rpx;
  box-sizing: border-box;
}

.exam-create-draft-btn {
  width: 140rpx;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid #d8dde5;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.08);
  color: #1f2937;
  font-size: 30rpx;
  line-height: 60rpx;
  box-sizing: border-box;
}

.exam-create-next-btn {
  width: 150rpx;
  height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 16rpx;
  background: #0aa65c;
  box-shadow: 0 10rpx 24rpx rgba(7, 130, 73, 0.24);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 60rpx;
  box-sizing: border-box;
}

.exam-create-tabs {
  height: 96rpx;
  display: grid;
  grid-template-columns: max-content max-content;
  align-items: end;
  gap: 70rpx;
  padding-left: 24rpx;
  box-sizing: border-box;
}

.exam-create-tab {
  position: relative;
  height: 76rpx;
  color: #59616d;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 64rpx;
  white-space: nowrap;
}

.exam-create-tab.active {
  color: #078249;
  font-weight: 900;
}

.exam-create-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 120rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #078249;
  content: "";
  transform: translateX(-50%);
}

.exam-create-form-card {
  margin-top: 14rpx;
  padding: 28rpx 34rpx 38rpx;
  border: 1rpx solid #edf1f5;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 40, 0.08);
  box-sizing: border-box;
}

.exam-create-scope-tip {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
  padding: 0 20rpx;
  border-left: 6rpx solid #0aa65c;
  background: #f0faf5;
  color: #3f5d4d;
  font-size: 27rpx;
  line-height: 38rpx;
  box-sizing: border-box;
}

.exam-create-field {
  min-height: 112rpx;
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  align-items: center;
  border-bottom: 1rpx solid #e6ebf0;
  box-sizing: border-box;
}

.exam-create-field.remark {
  min-height: 250rpx;
  align-items: start;
  padding-top: 28rpx;
  border-bottom: none;
}

.exam-create-label {
  color: #111827;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.exam-create-label.required::after {
  margin-left: 8rpx;
  color: #ff2d20;
  content: "*";
  font-weight: 900;
}

.exam-create-value {
  min-height: 86rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 42rpx;
  align-items: center;
  color: #1f2937;
  font-size: 31rpx;
  line-height: 44rpx;
  overflow-wrap: anywhere;
}

.exam-create-value.placeholder,
.exam-create-input {
  color: #9aa2ad;
}

.exam-create-value.muted {
  color: #b8bec7;
}

.exam-create-input {
  width: 100%;
  height: 72rpx;
  font-size: 31rpx;
  line-height: 72rpx;
}

.exam-create-date {
  width: 100%;
  height: 66rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7dde5;
  border-radius: 16rpx;
  color: #1f2937;
  font-size: 29rpx;
  box-sizing: border-box;
}

.exam-create-textarea {
  width: 100%;
  height: 210rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d7dde5;
  border-radius: 16rpx;
  color: #1f2937;
  font-size: 29rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.exam-create-submit-btn {
  min-width: 142rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 16rpx;
  background: #0aa65c;
  box-shadow: 0 10rpx 24rpx rgba(7, 130, 73, 0.24);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 56rpx;
  box-sizing: border-box;
}

.exam-create-submit-btn.disabled {
  opacity: 0.65;
}

.exam-source-panel {
  margin-top: 14rpx;
  padding-bottom: 30rpx;
}

.exam-source-segment {
  height: 78rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 7rpx;
  border: 1rpx solid #dfe5e9;
  border-radius: 8rpx;
  background: #eaf0ed;
  box-sizing: border-box;
}

.exam-source-segment-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 6rpx;
  color: #59616d;
  font-size: 29rpx;
  font-weight: 600;
}

.exam-source-segment-item.active {
  background: #078249;
  box-shadow: 0 6rpx 16rpx rgba(7, 130, 73, 0.22);
  color: #ffffff;
}

.exam-source-caption {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #59616d;
  font-size: 27rpx;
}

.exam-source-refresh {
  height: 56rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  color: #078249;
  font-size: 27rpx;
}

.exam-source-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.exam-paper-card,
.exam-bank-card {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid #e2e8e5;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(25, 45, 35, 0.06);
  box-sizing: border-box;
}

.exam-paper-card.selected,
.exam-bank-card.selected {
  border-color: #0aa65c;
  background: #f5fcf8;
  box-shadow: 0 8rpx 24rpx rgba(7, 130, 73, 0.12);
}

.exam-select-mark {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  border: 2rpx solid #aeb8b2;
  border-radius: 50%;
  box-sizing: border-box;
}

.exam-select-mark.square {
  border-radius: 5rpx;
}

.selected .exam-select-mark {
  border-color: #078249;
  background: #078249;
}

.exam-paper-main,
.exam-bank-main {
  min-width: 0;
}

.exam-paper-name {
  color: #172033;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.exam-paper-meta,
.exam-paper-scope,
.exam-bank-scope {
  margin-top: 10rpx;
  color: #68736d;
  font-size: 25rpx;
  line-height: 36rpx;
}

.exam-paper-scope,
.exam-bank-scope {
  color: #078249;
}

.exam-paper-description {
  margin-top: 12rpx;
  color: #7a827e;
  font-size: 26rpx;
  line-height: 38rpx;
}

.exam-bank-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.exam-bank-type {
  padding: 5rpx 12rpx;
  border-left: 5rpx solid #078249;
  background: #e9f6ef;
  color: #166a43;
  font-size: 24rpx;
  line-height: 32rpx;
}

.exam-bank-score {
  flex: none;
  color: #d66b19;
  font-size: 25rpx;
}

.exam-bank-question {
  margin-top: 14rpx;
  color: #202a25;
  font-size: 29rpx;
  line-height: 44rpx;
  overflow-wrap: anywhere;
}

.exam-source-empty {
  min-height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ccd6d1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #8a948f;
  font-size: 28rpx;
}
