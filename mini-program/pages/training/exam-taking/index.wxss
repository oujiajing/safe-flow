page {
  margin: 0;
  padding: 0;
  background: #ffffff;
  color: #2d3035;
}

.exam-taking-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-taking-topbar {
  height: 96rpx;
  display: grid;
  grid-template-columns: 76rpx 90rpx minmax(0, 1fr) 68rpx 68rpx minmax(84rpx, auto);
  align-items: center;
  padding: 0 34rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-taking-back {
  width: 76rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.exam-taking-timer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #20242a;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 32rpx;
}

.exam-taking-timer-gauge {
  position: relative;
  width: 52rpx;
  height: 25rpx;
  margin-bottom: 2rpx;
  overflow: hidden;
}

.exam-taking-timer-gauge::before {
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 38rpx;
  height: 38rpx;
  border: 7rpx solid #2d3035;
  border-bottom-color: transparent;
  border-left-color: transparent;
  border-radius: 50%;
  content: "";
  transform: rotate(-45deg);
}

.exam-taking-timer-gauge::after {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2d3035;
  content: "";
}

.exam-taking-spacer {
  min-width: 0;
}

.exam-taking-mark,
.exam-taking-answer-card {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.exam-taking-answer-card:active {
  opacity: 0.55;
}

.exam-taking-mark {
  z-index: 0;
}

.exam-taking-mark::after {
  position: absolute;
  left: 12rpx;
  bottom: 8rpx;
  width: 48rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #ff8a50;
  content: "";
  opacity: 0;
  z-index: -1;
}

.exam-taking-mark.active::after,
.exam-taking-mark.annotated::after {
  opacity: 1;
}

.exam-taking-count {
  min-width: 84rpx;
  color: #20242a;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: right;
  white-space: nowrap;
}

.exam-taking-progress {
  height: 8rpx;
  margin: 0 34rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f1f1f1;
}

.exam-taking-progress-fill {
  height: 8rpx;
  min-width: 22rpx;
  border-radius: 999rpx;
  background: #ff5b00;
}

.exam-taking-body {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 34rpx 36rpx;
  box-sizing: border-box;
}

.exam-annotation-canvas {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.exam-annotation-canvas.active {
  pointer-events: auto;
}

.exam-annotation-toolbar {
  position: absolute;
  z-index: 4;
  top: 12rpx;
  right: 34rpx;
  display: flex;
  gap: 14rpx;
}

.exam-annotation-action {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border-radius: 27rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 54rpx;
  box-sizing: border-box;
}

.exam-annotation-action.clear {
  border: 2rpx solid #ff5b00;
  background: #ffffff;
  color: #ff5b00;
}

.exam-annotation-action.done {
  background: #ff5b00;
  color: #ffffff;
}

.exam-taking-type-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 36rpx;
}

.exam-taking-type {
  flex: 0 0 auto;
  width: 150rpx;
  min-width: 150rpx;
  height: 42rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #fff0e9;
  color: #ff5b00;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 42rpx;
  box-sizing: border-box;
}

.exam-taking-instruction {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #73777f;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exam-taking-question {
  color: #33363b;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 60rpx;
  word-break: break-all;
}

.exam-taking-case {
  margin-bottom: 34rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff7f2;
}

.exam-taking-case-title {
  margin-bottom: 14rpx;
  color: #ff5b00;
  font-size: 29rpx;
  font-weight: 800;
}

.exam-taking-case-material {
  color: #555b64;
  font-size: 29rpx;
  line-height: 48rpx;
  white-space: pre-wrap;
}

.exam-taking-case-children {
  display: flex;
  flex-direction: column;
}

.exam-taking-case-child {
  padding: 38rpx 0 44rpx;
  border-bottom: 2rpx solid #eeeeee;
}

.exam-taking-case-child:first-child {
  padding-top: 8rpx;
}

.exam-taking-case-child:last-child {
  padding-bottom: 12rpx;
  border-bottom: 0;
}

.exam-taking-case-child-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  color: #73777f;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.exam-taking-case-child-heading text:last-child {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #f3f4f5;
  color: #555b64;
}

.exam-taking-case-child .exam-taking-question {
  font-size: 32rpx;
  line-height: 52rpx;
}

.exam-taking-options {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
  margin-top: 58rpx;
}

.exam-taking-option {
  min-height: 118rpx;
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr);
  align-items: center;
  padding: 20rpx 34rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #f7f7f7;
  color: #2d3035;
  box-sizing: border-box;
}

.exam-taking-option.selected {
  border-color: #078249;
  background: #eef8f2;
}

.exam-taking-option-letter {
  color: #2d3035;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.exam-taking-option-text {
  min-width: 0;
  color: #2d3035;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.exam-taking-short-answer {
  width: 100%;
  min-height: 280rpx;
  margin-top: 42rpx;
  padding: 28rpx;
  border: 2rpx solid #d9dee6;
  border-radius: 16rpx;
  background: #fafafa;
  color: #2d3035;
  font-size: 31rpx;
  line-height: 48rpx;
  box-sizing: border-box;
}

.exam-taking-case-child .exam-taking-options {
  gap: 22rpx;
  margin-top: 28rpx;
}

.exam-taking-case-child .exam-taking-option {
  min-height: 104rpx;
  padding: 18rpx 28rpx;
}

.exam-taking-case-child .exam-taking-short-answer {
  min-height: 220rpx;
  margin-top: 28rpx;
}

.exam-taking-nav {
  padding-top: 34rpx;
  margin-top: auto;
}

.exam-taking-nav-btn {
  width: 100%;
  min-height: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 34rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 48rpx;
  box-sizing: border-box;
}

.exam-taking-nav-btn.secondary {
  border: 2rpx solid #d9dee6;
  background: #ffffff;
  color: #454c57;
}

.exam-taking-nav-btn.primary {
  background: #078249;
  color: #ffffff;
}

.exam-exit-mask {
  position: fixed;
  z-index: 1200;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.46);
  box-sizing: border-box;
}

.exam-exit-dialog {
  width: 100%;
  max-width: 654rpx;
  padding: 56rpx 42rpx 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.exam-exit-title {
  color: #20242a;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.exam-exit-description {
  margin-top: 18rpx;
  color: #8b8f94;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 42rpx;
  text-align: center;
}

.exam-exit-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
  margin-top: 48rpx;
}

.exam-exit-action {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 84rpx;
  box-sizing: border-box;
}

.exam-exit-action.confirm {
  background: transparent;
  color: #8b8f94;
}

.exam-exit-action.continue {
  background: #fff0e3;
  color: #d66700;
}

.exam-exit-action:active {
  opacity: 0.65;
}

.answer-card-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.46);
}

.answer-card-sheet {
  width: 100%;
  height: 46vh;
  max-height: 46vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.answer-card-header {
  position: relative;
  flex: 0 0 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.answer-card-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 40rpx 24rpx;
}

.answer-card-summary view {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 8rpx;
  border-radius: 14rpx;
  background: #f7f8fa;
}

.answer-card-summary b {
  color: #20242a;
  font-size: 32rpx;
  line-height: 44rpx;
}

.answer-card-summary text {
  margin-top: 4rpx;
  color: #73777f;
  font-size: 23rpx;
}

.answer-card-title {
  color: #303238;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.answer-card-close {
  position: absolute;
  top: 30rpx;
  right: 34rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.answer-card-content {
  flex: 1;
  min-height: 0;
  padding: 8rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.answer-card-section {
  margin-bottom: 50rpx;
}

.answer-card-section-title {
  margin-bottom: 34rpx;
  color: #5f6268;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.answer-card-grid {
  display: grid;
  grid-template-columns: repeat(5, 92rpx);
  justify-content: space-between;
  row-gap: 38rpx;
}

.answer-card-number {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 50%;
  background: #f5f5f5;
  color: #575a60;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-sizing: border-box;
}

.answer-card-number.answered {
  background: #fff3e8;
  color: #d66700;
}

.answer-card-number.correct {
  background: #e9f7ef;
  color: #078249;
}

.answer-card-number.incorrect {
  background: #fff0e3;
  color: #d35b00;
}

.answer-card-number.current {
  border-color: #ff5b00;
}

.answer-card-number:active {
  opacity: 0.62;
}

.answer-card-footer {
  flex: 0 0 auto;
  padding: 22rpx 34rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.answer-card-submit {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #ff5b00;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 92rpx;
}

.answer-card-submit:active {
  background: #e95000;
}

.answer-card-submit.result {
  background: #078249;
}
