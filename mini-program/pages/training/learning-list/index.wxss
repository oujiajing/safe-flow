page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f5f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding: 0 0 34rpx;
  overflow-x: hidden;
  background: #f5f7fb;
}

.learning-status-tabs {
  width: 100vw;
  height: 96rpx;
  overflow: hidden;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf1;
  box-sizing: border-box;
  white-space: nowrap;
}

.learning-status-tab-list {
  width: 100%;
  height: 96rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: flex-end;
  gap: 0;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.learning-status-tab {
  position: relative;
  min-width: 0;
  height: 76rpx;
  color: #4c5563;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 68rpx;
  text-align: center;
  white-space: nowrap;
}

.learning-status-tab.active {
  color: #2f6bff;
  font-weight: 900;
}

.learning-status-tab.active::after {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 58rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #2f6bff;
  content: "";
  transform: translateX(-50%);
}

.learning-filter-row {
  height: 112rpx;
  display: block;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #edf1f6;
  background: #ffffff;
  box-sizing: border-box;
}

.learning-search-box {
  min-width: 0;
  width: 100%;
  height: 68rpx;
  display: grid;
  grid-template-columns: 42rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  gap: 10rpx;
  padding: 0 8rpx 0 24rpx;
  border: 1rpx solid #dce4ee;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.03);
}

.learning-search-icon,
.learning-point-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.learning-search-input {
  min-width: 0;
  height: 66rpx;
  color: #172033;
  font-size: 27rpx;
  line-height: 66rpx;
}

.learning-search-submit {
  min-width: 0 !important;
  width: 112rpx !important;
  height: 54rpx !important;
  padding: 0 !important;
  border-radius: 999rpx !important;
  background: #2f6bff !important;
  color: #ffffff !important;
  font-size: 25rpx !important;
  font-weight: 900 !important;
  line-height: 54rpx !important;
}

.learning-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.learning-card {
  min-height: 180rpx;
  display: grid;
  grid-template-columns: 196rpx minmax(0, 1fr);
  gap: 24rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #ecf0f6;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(20, 35, 55, 0.07);
  box-sizing: border-box;
}

.learning-cover {
  width: 196rpx;
  height: 160rpx;
  align-self: center;
  overflow: hidden;
  border-radius: 14rpx;
  background: #eef3f8;
}

.learning-cover-image {
  width: 196rpx;
  height: 160rpx;
  display: block;
}

.learning-cover-placeholder {
  width: 196rpx;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  padding: 0 16rpx;
  background: linear-gradient(135deg, #f7b500 0%, #e5383b 42%, #3d6fb6 100%);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 32rpx;
  box-sizing: border-box;
}

.learning-card-main {
  min-width: 0;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.learning-card-top {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 94rpx;
  gap: 14rpx;
  align-items: start;
}

.learning-title {
  min-width: 0;
  max-height: 74rpx;
  overflow: hidden;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 37rpx;
  word-break: break-all;
}

.learning-status-pill {
  min-width: 86rpx;
  height: 42rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 42rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.learning-status-pill.pending {
  background: #fff7e6;
  color: #d97706;
}

.learning-status-pill.progress {
  background: #fff7e6;
  color: #d97706;
}

.learning-status-pill.done {
  background: #e7f6ef;
  color: #078249;
}

.learning-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  color: #687386;
  font-size: 24rpx;
  line-height: 32rpx;
}

.learning-meta-item {
  min-width: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
}

.learning-meta-item text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.learning-meta-divider {
  width: 1rpx;
  height: 24rpx;
  background: #d6dde8;
  flex: 0 0 1rpx;
}

.learning-point-item {
  flex: 0 0 auto;
}
