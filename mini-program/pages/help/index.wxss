page { background: #f4f6f5; }
.help-page { min-height: 100vh; padding: 24rpx; color: #172033; background: #f4f6f5; box-sizing: border-box; }
.intro-card, .faq-card, .support-card { border: 1rpx solid #e3e9e6; border-radius: 20rpx; background: #fff; }
.intro-card { display: flex; gap: 20rpx; align-items: center; padding: 28rpx 24rpx; }
.intro-title, .support-title { color: #111827; font-size: 30rpx; font-weight: 900; }
.intro-note, .support-note { margin-top: 8rpx; color: #7a8491; font-size: 23rpx; line-height: 36rpx; }
.faq-card { margin-top: 20rpx; padding: 0 24rpx; }
.faq-item { padding: 25rpx 0; border-bottom: 1rpx solid #e7ebe9; }
.faq-item:last-child { border-bottom: 0; }
.faq-question { display: flex; justify-content: space-between; gap: 20rpx; color: #263142; font-size: 27rpx; font-weight: 800; }
.faq-answer { padding: 18rpx 44rpx 0 0; color: #65717d; font-size: 24rpx; line-height: 38rpx; }
.support-card { margin-top: 20rpx; padding: 28rpx 24rpx; }
.support-button { margin-top: 24rpx; border: 1rpx solid #078c59; border-radius: 14rpx; color: #078c59; background: #fff; font-size: 26rpx; font-weight: 800; }
.support-button::after { border: 0; }
