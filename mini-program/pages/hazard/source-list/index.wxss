  width: 148rpx;
  height: 70rpx;
  border-radius: 28rpx;
  background: #e7f6ef;
  color: #0c9660;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 70rpx;
}

.source-toolbar-inline .source-primary,
.source-toolbar-safety .source-primary {
  width: 168rpx;
  height: 60rpx;
  border-radius: 32rpx;
  background: #13a66b;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.quick-shot-page .source-toolbar-inline .source-primary {
