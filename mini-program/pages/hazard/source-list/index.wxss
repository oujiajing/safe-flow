page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f4f6f8;
}

.source-page {
  min-height: 100vh;
  background: #ffffff;
  color: #202733;
}

.source-page.safety-check-page {
  background: #f4f6f8;
  --td-brand-color: #15a66a;
  --td-brand-color-active: #078f59;
  --td-brand-color-focus: #e7f6ef;
}

.quick-shot-page {
  background: #f4f6f8;
  --td-brand-color: #13a66b;
  --td-brand-color-active: #078f59;
  --td-brand-color-focus: #e7f6ef;
}

.source-toolbar {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eef0f3;
  box-sizing: border-box;
}

.quick-shot-page .source-toolbar {
  background: #ffffff;
}

.source-toolbar-inline {
  height: 92rpx;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
  padding: 0 44rpx;
  border-bottom: 1rpx solid #edf1f5;
  background: #ffffff;
}

.source-toolbar-safety {
  height: 92rpx;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: center;
  padding: 0 44rpx;
  border-bottom: 1rpx solid #edf1f5;
  background: #ffffff;
}

.source-primary {
  width: 148rpx;
  height: 58rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #1687ff;
  color: #fff;
  font-size: 26rpx;
  line-height: 58rpx;
}

.quick-shot-page .source-primary {
