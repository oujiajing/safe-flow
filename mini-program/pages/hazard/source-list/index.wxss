.source-create-icon,
.source-action-icon {
  position: relative;
  display: inline-block;
  width: 22rpx;
  height: 22rpx;
  margin-right: 2rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
  vertical-align: -2rpx;
}

.source-create-icon::before,
.source-create-icon::after,
.source-action-icon::before,
.source-action-icon::after {
  position: absolute;
  left: 50%;
  top: 50%;
  background: currentColor;
  content: "";
  transform: translate(-50%, -50%);
}

.source-create-icon::before,
.source-action-icon::before {
  width: 11rpx;
  height: 2rpx;
}

.source-create-icon::after,
.source-action-icon::after {
  width: 2rpx;
  height: 11rpx;
}

.source-primary::after,
.source-secondary::after {
  border: 0;
}

.source-filter-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.source-filter-icon::before {
  position: absolute;
  left: 0;
  top: 2rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 24rpx solid #263b4c;
  content: "";
}

.source-filter-icon::after {
  position: absolute;
  left: 12rpx;
  top: 22rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 14rpx solid #263b4c;
  content: "";
}

