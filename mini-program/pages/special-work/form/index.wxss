@import "../common.wxss";
.sw-form-steps { padding: 22rpx 54rpx; display: grid; grid-template-columns: repeat(3,1fr); background: #fff; border-bottom: 1rpx solid #eceff2; }.sw-form-step { position: relative; display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: #98a2b3; font-size: 23rpx; }.sw-form-step::before { content: ""; height: 3rpx; position: absolute; left: -50%; right: 50%; top: 20rpx; background: #d9dde3; }.sw-form-step:first-child::before { display: none; }.sw-form-step text { width: 40rpx; height: 40rpx; z-index: 1; border-radius: 50%; background: #d9dde3; color: #fff; line-height: 40rpx; text-align: center; }.sw-form-step.done::before { background: #168a5b; }.sw-form-step.done text,.sw-form-step.current text { background: #168a5b; }.sw-form-step.done,.sw-form-step.current { color: #168a5b; font-weight: 700; }
.sw-form-content { padding-top: 20rpx; }.sw-form-card { padding-top: 22rpx; }.sw-form-row,.sw-date-row { min-height: 102rpx; display: grid; grid-template-columns: 220rpx 1fr 30rpx; align-items: center; border-bottom: 1rpx solid #edf0f3; box-sizing: border-box; font-size: 27rpx; }.sw-form-row input { width: 100%; height: 72rpx; color: #344054; font-size: 27rpx; text-align: right; }.sw-form-row .value { color: #667085; text-align: right; }.required::before { content: "*"; margin-right: 7rpx; color: #ef4444; }
.sw-date-row { grid-template-columns: 250rpx 1fr; }.sw-date-pickers { display: flex; justify-content: flex-end; gap: 10rpx; }.sw-date-pickers picker { padding: 12rpx 14rpx; border-radius: 9rpx; background: #f4f6f8; color: #475467; font-size: 23rpx; }
.sw-textarea-row { padding: 24rpx 0; border-bottom: 1rpx solid #edf0f3; font-size: 27rpx; }.sw-textarea-row > text { display: block; margin-bottom: 14rpx; }.sw-textarea-row textarea { width: 100%; height: 128rpx; padding: 18rpx; box-sizing: border-box; border-radius: 12rpx; background: #f6f7f9; color: #344054; font-size: 26rpx; }
.sw-image-field { padding-top: 24rpx; font-size: 27rpx; }.sw-image-preview { height: 260rpx; margin-top: 16rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #cfd7df; border-radius: 14rpx; background: #f8fafb; }.sw-image-preview image { width: 100%; height: 100%; }.sw-image-preview > view { display: flex; flex-direction: column; align-items: center; gap: 10rpx; color: #667085; font-size: 24rpx; }.sw-image-change { width: 190rpx !important; height: 64rpx; min-height: 64rpx; margin: 16rpx 0 0 auto !important; padding: 0 !important; border: 1rpx solid #168a5b; border-radius: 9rpx; background: #fff; color: #168a5b; font-size: 24rpx; line-height: 64rpx; }.sw-image-change::after { border: 0; }.sw-form-error { margin-left: 0; margin-right: 0; }
