<view class="sw-page">
  <green-header title="{{id ? '编辑特种作业' : '新建特种作业'}}" bind:back="goBack" />
  <view class="sw-form-steps"><view wx:for="{{steps}}" wx:key="*this" class="sw-form-step {{step === index ? 'current' : (step > index ? 'done' : '')}}"><text>{{index + 1}}</text><label>{{item}}</label></view></view>
  <view class="sw-content sw-form-content">
    <view wx:if="{{step === 0}}" class="sw-card sw-form-card">
      <view class="sw-section-title">申请信息</view>
      <picker mode="selector" range="{{companyOptions}}" range-key="label" value="{{companyIndex}}" bindchange="changeCompany"><view class="sw-form-row"><text class="required">公司</text><text class="value">{{companyOptions[companyIndex].label || '请选择公司'}}</text><t-icon name="chevron-right" size="30rpx" color="#98a2b3" /></view></picker>
      <view class="sw-form-row"><text class="required">项目</text><input value="{{form.project}}" data-field="project" bindinput="updateField" placeholder="请输入项目" /></view>
      <picker mode="selector" range="{{workTypes}}" value="{{workTypeIndex}}" bindchange="changeWorkType"><view class="sw-form-row"><text class="required">作业类型</text><text class="value">{{form.workType}}</text><t-icon name="chevron-right" size="30rpx" color="#98a2b3" /></view></picker>
      <view class="sw-date-row"><text class="required">作业申请时间</text><view class="sw-date-pickers"><picker mode="date" value="{{dateTimes.applicationTime.date}}" data-field="applicationTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.applicationTime.date || '选择日期'}}</text></picker><picker mode="time" value="{{dateTimes.applicationTime.time}}" data-field="applicationTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.applicationTime.time || '选择时间'}}</text></picker></view></view>
      <view class="sw-textarea-row"><text>作业内容</text><textarea value="{{form.workContent}}" data-field="workContent" bindinput="updateField" maxlength="500" placeholder="请输入作业内容" /></view>
      <view class="sw-textarea-row"><text>作业地点</text><textarea value="{{form.workLocation}}" data-field="workLocation" bindinput="updateField" maxlength="300" placeholder="请输入作业地点" /></view>
      <view class="sw-textarea-row"><text>风险辨识结果</text><textarea value="{{form.riskIdentificationResult}}" data-field="riskIdentificationResult" bindinput="updateField" maxlength="500" placeholder="请输入风险辨识与措施落实结果" /></view>
      <view class="sw-image-field"><text>现场图片</text><view class="sw-image-preview" bindtap="handleImageTap"><image wx:if="{{selectedImagePath}}" src="{{selectedImagePath}}" mode="aspectFill" /><image wx:elif="{{existingImage}}" src="{{existingImage.url}}" mode="aspectFill" /><view wx:else><t-icon name="camera" size="48rpx" color="#168a5b" /><text>拍摄或选择图片</text></view></view><button class="sw-image-change" bindtap="chooseImage">{{selectedImagePath || existingImage ? '更换图片' : '选择图片'}}</button></view>
    </view>
    <view wx:elif="{{step === 1}}" class="sw-card sw-form-card"><view class="sw-section-title">作业实施</view><view class="sw-date-row"><text>作业实施时间(开始)</text><view class="sw-date-pickers"><picker mode="date" value="{{dateTimes.implementationStartTime.date}}" data-field="implementationStartTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.implementationStartTime.date || '选择日期'}}</text></picker><picker mode="time" value="{{dateTimes.implementationStartTime.time}}" data-field="implementationStartTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.implementationStartTime.time || '选择时间'}}</text></picker></view></view><view class="sw-date-row"><text>作业实施时间(结束)</text><view class="sw-date-pickers"><picker mode="date" value="{{dateTimes.implementationEndTime.date}}" data-field="implementationEndTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.implementationEndTime.date || '选择日期'}}</text></picker><picker mode="time" value="{{dateTimes.implementationEndTime.time}}" data-field="implementationEndTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.implementationEndTime.time || '选择时间'}}</text></picker></view></view></view>
    <view wx:else class="sw-card sw-form-card"><view class="sw-section-title">人员与完工验收</view><view class="sw-form-row"><text>安全交底人</text><input value="{{form.safetyDisclosurePerson}}" data-field="safetyDisclosurePerson" bindinput="updateField" placeholder="请输入姓名" /></view><view class="sw-form-row"><text>监护人</text><input value="{{form.guardian}}" data-field="guardian" bindinput="updateField" placeholder="请输入姓名" /></view><view class="sw-form-row"><text>接受交底人</text><input value="{{form.disclosureReceiver}}" data-field="disclosureReceiver" bindinput="updateField" placeholder="请输入姓名或人员" /></view><view class="sw-form-row"><text>完工验收人</text><input value="{{form.completionAcceptor}}" data-field="completionAcceptor" bindinput="updateField" placeholder="请输入姓名" /></view><view class="sw-date-row"><text>完工验收时间</text><view class="sw-date-pickers"><picker mode="date" value="{{dateTimes.completionAcceptanceTime.date}}" data-field="completionAcceptanceTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.completionAcceptanceTime.date || '选择日期'}}</text></picker><picker mode="time" value="{{dateTimes.completionAcceptanceTime.time}}" data-field="completionAcceptanceTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.completionAcceptanceTime.time || '选择时间'}}</text></picker></view></view></view>
    <view wx:if="{{errorText}}" class="sw-error sw-form-error">{{errorText}}</view>
  </view>
  <view class="sw-bottom"><button class="sw-outline" bindtap="handleBackStep">{{step === 0 ? '取消' : '上一步'}}</button><button wx:if="{{step < 2}}" class="sw-primary" bindtap="nextStep">下一步</button><button wx:else class="sw-primary" bindtap="submit" loading="{{saving}}">{{id ? '保存修改' : '提交申请'}}</button></view>
</view>
