<view class="sw-page">
  <green-header title="作业票详情" bind:back="goBack" />
  <view class="sw-content">
    <view wx:if="{{loading}}" class="sw-empty">正在加载作业票…</view>
    <view wx:elif="{{errorText}}" class="sw-error">{{errorText}}</view>
    <block wx:elif="{{record}}">
      <view class="sw-hero"><view class="sw-fire"><t-icon name="fire" size="44rpx" color="#ffffff" /></view><view class="sw-hero-main"><text class="sw-hero-type">{{record.workType}}</text><text class="sw-hero-project">{{record.project}}</text><text class="sw-hero-company">{{record.company}}</text></view><text class="sw-status {{record.statusClass}}">{{record.statusLabel}}</text></view>
      <view class="sw-progress"><view class="sw-step {{record.status !== 'PENDING_APPROVAL' ? 'done' : 'current'}}"><text>1</text><label>待审批</label></view><view class="sw-step {{record.status === 'IN_PROGRESS' ? 'current' : (record.status === 'PENDING_ACCEPTANCE' || record.status === 'COMPLETED' ? 'done' : '')}}"><text>2</text><label>作业中</label></view><view class="sw-step {{record.status === 'PENDING_ACCEPTANCE' ? 'current' : (record.status === 'COMPLETED' ? 'done' : '')}}"><text>3</text><label>待验收</label></view><view class="sw-step {{record.status === 'COMPLETED' ? 'done current' : ''}}"><text>4</text><label>已完成</label></view></view>
      <view class="sw-card"><view class="sw-section-title">申请信息</view><view class="sw-detail-row"><text>公司</text><text>{{record.company || '-'}}</text></view><view class="sw-detail-row"><text>项目</text><text>{{record.project || '-'}}</text></view><view class="sw-detail-row"><text>作业类型</text><text>{{record.workType || '-'}}</text></view><view class="sw-detail-row"><text>作业申请时间</text><text>{{record.applicationTimeLabel}}</text></view><view class="sw-detail-row"><text>作业内容</text><text>{{record.workContent || '-'}}</text></view><view class="sw-detail-row"><text>作业地点</text><text>{{record.workLocation || '-'}}</text></view><view class="sw-detail-row"><text>风险辨识结果</text><text>{{record.riskIdentificationResult || '-'}}</text></view></view>
      <view class="sw-card"><view class="sw-section-title">作业实施</view><view class="sw-detail-row"><text>作业实施时间(开始)</text><text>{{record.implementationStartTimeLabel}}</text></view><view class="sw-detail-row"><text>作业实施时间(结束)</text><text>{{record.implementationEndTimeLabel}}</text></view></view>
      <view class="sw-card"><view class="sw-section-title">人员与交底</view><view class="sw-detail-row"><text>安全交底人</text><text>{{record.safetyDisclosurePerson || '-'}}</text></view><view class="sw-detail-row"><text>监护人</text><text>{{record.guardian || '-'}}</text></view><view class="sw-detail-row"><text>接受交底人</text><text>{{record.disclosureReceiver || '-'}}</text></view></view>
      <view class="sw-card"><view class="sw-section-title">完工验收</view><view class="sw-detail-row"><text>完工验收人</text><text>{{record.completionAcceptor || '-'}}</text></view><view class="sw-detail-row"><text>完工验收时间</text><text>{{record.completionAcceptanceTimeLabel}}</text></view></view>
      <view class="sw-card"><view class="sw-section-title">现场图片</view><image wx:if="{{record.image}}" class="sw-image" src="{{record.image.url}}" mode="aspectFill" bindtap="previewImage" /><view wx:else class="sw-no-image">暂无现场图片</view></view>
    </block>
  </view>
  <view wx:if="{{record && (canEdit || canProcess)}}" class="sw-bottom"><button wx:if="{{canEdit && record.status !== 'COMPLETED'}}" class="sw-outline" bindtap="openEdit">编辑作业票</button><button wx:if="{{canProcess}}" class="sw-primary" bindtap="openWorkflow">{{actionLabel}}</button></view>
</view>
