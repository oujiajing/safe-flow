@import "../common.wxss";
.sw-hero { margin-bottom: 20rpx; padding: 28rpx; display: flex; align-items: center; gap: 18rpx; border-radius: 22rpx; background: linear-gradient(135deg,#087b4f,#16a36c); color: #fff; box-shadow: 0 8rpx 26rpx rgba(22,138,91,.22); }.sw-fire { width: 78rpx; height: 78rpx; flex: 0 0 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.18); }.sw-hero-main { min-width: 0; flex: 1; }.sw-hero-type { display: block; font-size: 34rpx; font-weight: 900; }.sw-hero-project,.sw-hero-company { display: block; margin-top: 8rpx; overflow: hidden; font-size: 24rpx; opacity: .9; text-overflow: ellipsis; white-space: nowrap; }.sw-hero .sw-status { align-self: flex-start; background: rgba(255,255,255,.94); }
.sw-progress { margin: 0 -24rpx 20rpx; padding: 18rpx 34rpx 22rpx; display: grid; grid-template-columns: repeat(4,1fr); background: #fff; border-top: 1rpx solid #eceef1; border-bottom: 1rpx solid #eceef1; }.sw-step { min-width: 0; position: relative; display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: #8a94a4; font-size: 22rpx; }.sw-step::before { content: ""; height: 3rpx; position: absolute; left: -50%; right: 50%; top: 20rpx; background: #d3d7de; }.sw-step:first-child::before { display: none; }.sw-step text { width: 40rpx; height: 40rpx; z-index: 1; border-radius: 50%; background: #d3d7de; color: #fff; line-height: 40rpx; text-align: center; }.sw-step.done::before { background: #168a5b; }.sw-step.done text,.sw-step.current text { background: #168a5b; }.sw-step.done,.sw-step.current { color: #344054; font-weight: 700; }
.sw-image { width: 100%; height: 320rpx; display: block; border-radius: 14rpx; }.sw-no-image { height: 180rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #d7dce2; border-radius: 14rpx; color: #98a2b3; font-size: 26rpx; }
