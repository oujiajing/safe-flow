<view class="sw-page">
  <green-header title="作业状态处理" bind:back="goBack" />
  <view class="sw-content sw-workflow-content">
    <view wx:if="{{loading}}" class="sw-empty">正在加载状态…</view><view wx:elif="{{errorText && !record}}" class="sw-error">{{errorText}}</view>
    <block wx:elif="{{record}}">
      <view class="sw-flow-card"><view wx:for="{{steps}}" wx:key="value" class="sw-flow-step {{item.state}}"><view class="sw-flow-marker"><text>{{item.index}}</text></view><view class="sw-flow-copy"><text>{{item.label}}</text><label>{{item.state === 'current' ? '当前阶段' : (item.state === 'done' ? '已完成' : '待处理')}}</label></view></view></view>
      <view class="sw-card sw-summary"><view><text class="sw-summary-type">{{record.workType}}</text><text>{{record.project}} · {{record.company}}</text></view><text class="sw-status {{record.statusClass}}">{{record.statusLabel}}</text></view>
      <view wx:if="{{record.status === 'PENDING_APPROVAL'}}" class="sw-card sw-action-card"><view class="sw-section-title">作业实施与安全交底</view><view class="sw-date-action"><text class="required">作业实施时间(开始)</text><view><picker mode="date" value="{{dateTimes.implementationStartTime.date}}" data-field="implementationStartTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.implementationStartTime.date}}</text></picker><picker mode="time" value="{{dateTimes.implementationStartTime.time}}" data-field="implementationStartTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.implementationStartTime.time}}</text></picker></view></view><view class="sw-action-row"><text class="required">安全交底人</text><input value="{{form.safetyDisclosurePerson}}" data-field="safetyDisclosurePerson" bindinput="updateField" placeholder="请输入姓名" /></view><view class="sw-action-row"><text class="required">监护人</text><input value="{{form.guardian}}" data-field="guardian" bindinput="updateField" placeholder="请输入姓名" /></view><view class="sw-action-row"><text class="required">接受交底人</text><input value="{{form.disclosureReceiver}}" data-field="disclosureReceiver" bindinput="updateField" placeholder="请输入姓名或人员" /></view></view>
      <view wx:elif="{{record.status === 'IN_PROGRESS'}}" class="sw-card sw-action-card"><view class="sw-section-title">作业结束</view><view class="sw-date-action"><text class="required">作业实施时间(结束)</text><view><picker mode="date" value="{{dateTimes.implementationEndTime.date}}" data-field="implementationEndTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.implementationEndTime.date}}</text></picker><picker mode="time" value="{{dateTimes.implementationEndTime.time}}" data-field="implementationEndTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.implementationEndTime.time}}</text></picker></view></view></view>
      <view wx:elif="{{record.status === 'PENDING_ACCEPTANCE'}}" class="sw-card sw-action-card"><view class="sw-section-title">完工验收</view><view class="sw-action-row"><text class="required">完工验收人</text><input value="{{form.completionAcceptor}}" data-field="completionAcceptor" bindinput="updateField" placeholder="请输入姓名" /></view><view class="sw-date-action"><text class="required">完工验收时间</text><view><picker mode="date" value="{{dateTimes.completionAcceptanceTime.date}}" data-field="completionAcceptanceTime" data-part="date" bindchange="changeDateTime"><text>{{dateTimes.completionAcceptanceTime.date}}</text></picker><picker mode="time" value="{{dateTimes.completionAcceptanceTime.time}}" data-field="completionAcceptanceTime" data-part="time" bindchange="changeDateTime"><text>{{dateTimes.completionAcceptanceTime.time}}</text></picker></view></view></view>
      <view wx:else class="sw-card sw-complete-card"><t-icon name="check-circle-filled" size="72rpx" color="#168a5b" /><text>该特种作业已完成验收</text><label>所有作业实施与完工验收信息已同步至 PC 端。</label></view>
      <view wx:if="{{errorText}}" class="sw-error sw-inline-error">{{errorText}}</view>
    </block>
  </view>
  <view wx:if="{{record && nextStatus}}" class="sw-bottom sw-bottom-single"><button class="sw-primary" bindtap="submitTransition" loading="{{saving}}">{{actionLabel}}</button></view>
</view>
