@import "../common.wxss";
.sw-workflow-content { padding-top: 20rpx; }.sw-flow-card { margin-bottom: 20rpx; padding: 24rpx 28rpx; border-radius: 20rpx; background: #fff; }.sw-flow-step { min-height: 86rpx; position: relative; display: grid; grid-template-columns: 56rpx 1fr; gap: 16rpx; }.sw-flow-step::after { content: ""; width: 3rpx; position: absolute; left: 27rpx; top: 50rpx; bottom: -2rpx; background: #d5d9df; }.sw-flow-step:last-child::after { display: none; }.sw-flow-marker { width: 50rpx; height: 50rpx; z-index: 1; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #d5d9df; color: #fff; font-size: 24rpx; }.sw-flow-step.done .sw-flow-marker,.sw-flow-step.current .sw-flow-marker { background: #168a5b; }.sw-flow-step.done::after { background: #168a5b; }.sw-flow-copy > text { display: block; color: #344054; font-size: 28rpx; font-weight: 800; }.sw-flow-copy label { display: block; margin-top: 5rpx; color: #98a2b3; font-size: 23rpx; }.sw-flow-step.current .sw-flow-copy label { color: #f59e0b; }
.sw-summary { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.sw-summary > view { min-width: 0; }.sw-summary-type { display: block; margin-bottom: 8rpx; font-size: 31rpx; font-weight: 800; }.sw-summary > view > text:last-child { color: #667085; font-size: 24rpx; }
.sw-action-row,.sw-date-action { min-height: 100rpx; display: grid; grid-template-columns: 250rpx 1fr; align-items: center; border-bottom: 1rpx solid #edf0f3; font-size: 26rpx; }.sw-action-row input { width: 100%; height: 72rpx; color: #344054; font-size: 26rpx; text-align: right; }.required::before { content: "*"; margin-right: 7rpx; color: #ef4444; }.sw-date-action > view { display: flex; justify-content: flex-end; gap: 8rpx; }.sw-date-action picker { padding: 12rpx; border-radius: 8rpx; background: #f4f6f8; color: #475467; font-size: 22rpx; }
.sw-complete-card { display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 50rpx 30rpx; text-align: center; }.sw-complete-card > text { font-size: 30rpx; font-weight: 800; }.sw-complete-card label { color: #667085; font-size: 24rpx; line-height: 38rpx; }.sw-inline-error { margin-left: 0; margin-right: 0; }.sw-bottom-single { grid-template-columns: 1fr; }
