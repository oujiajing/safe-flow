<view class="analysis-page">
  <green-header title="作业派班分析" bind:back="goBack" />
  <view class="analysis-content dispatch-analysis">
    <scope-filter compact="{{true}}" context="{{context}}" scopeTree="{{scopeTree}}" scopeAccess="{{scopeAccess}}" rangeText="{{rangeText}}" updatedAt="{{updatedAt}}" bind:apply="handleFilterApply" />
    <state-view wx:if="{{loading}}" loading="{{true}}" loadingText="正在加载派班分析" />
    <state-view wx:elif="{{errorMessage}}" errorText="{{errorMessage}}" bind:retry="retryLoad" />
    <view wx:elif="{{noPermission}}" class="permission-card"><t-icon name="lock-on" size="66rpx" color="#94a3b8" /><view class="permission-title">暂无查看权限</view></view>
    <block wx:else>
      <view class="analysis-kpi-strip">
        <view class="strip-metric"><text class="strip-label">有效派班</text><text class="strip-value blue">{{model.dispatch.total}}</text><text class="strip-foot">班次</text></view>
        <view class="strip-metric"><text class="strip-label">已完成</text><text class="strip-value">{{model.dispatch.finished}}</text><text class="strip-foot">班次</text></view>
        <view class="strip-metric"><text class="strip-label">待完成</text><text class="strip-value orange">{{model.dispatch.pending}}</text><text class="strip-foot">班次</text></view>
        <view class="strip-metric"><text class="strip-label">完成率</text><text class="strip-value">{{model.dispatch.rate}}</text></view>
      </view>

      <view class="analysis-section dispatch-org-chart">
        <view class="section-head"><view class="section-title">各组织派班完成情况</view><view class="section-detail-action {{detailCards.dispatchOrg ? 'active' : ''}}" data-card="dispatchOrg" bindtap="toggleCardDetail">{{detailCards.dispatchOrg ? '图表' : '明细'}}</view></view>
        <block wx:if="{{!detailCards.dispatchOrg}}">
          <view class="legend-row"><view class="legend-item"><text class="legend-dot"></text>已完成</view><view class="legend-item"><text class="legend-dot orange"></text>待完成</view></view>
          <view wx:for="{{model.dispatch.rows}}" wx:key="name" class="dispatch-chart-row">
            <text class="dispatch-chart-name">{{item.name}}</text>
            <view class="dispatch-chart-bar"><view class="bar-fill" style="width:{{item.finishedWidth}}"><text wx:if="{{item.finished}}">{{item.finished}}</text></view><view class="bar-fill orange" style="width:{{item.pendingWidth}}"><text wx:if="{{item.pending}}">{{item.pending}}</text></view></view>
            <text class="dispatch-chart-total">{{item.total}}</text>
          </view>
        </block>
        <view wx:else class="analysis-detail-table dispatch-detail-table">
          <view class="analysis-detail-head dispatch-table-grid"><text>组织名称</text><text>有效派班</text><text>已完成</text><text>待完成</text><text>完成率</text></view>
          <view wx:for="{{model.dispatch.rows}}" wx:key="name" class="analysis-detail-row dispatch-table-grid">
            <text class="dispatch-table-name">{{item.name}}</text><text class="blue">{{item.total}}</text><text class="green">{{item.finished}}</text><text class="orange">{{item.pending}}</text><text class="green">{{item.rate}}</text>
          </view>
        </view>
        <view wx:if="{{!model.dispatch.rows.length}}" class="empty-inline">暂无组织派班数据</view>
      </view>

      <view class="analysis-section dispatch-trend-card">
        <view class="section-head"><view class="section-title">近7日派班趋势</view><view class="section-detail-action {{detailCards.dispatchTrend ? 'active' : ''}}" data-card="dispatchTrend" bindtap="toggleCardDetail">{{detailCards.dispatchTrend ? '图表' : '明细'}}</view></view>
        <block wx:if="{{!detailCards.dispatchTrend}}">
          <view class="legend-row"><view class="legend-item"><text class="legend-dot"></text>已完成</view><view class="legend-item"><text class="legend-dot orange"></text>待完成</view></view>
          <canvas wx:if="{{model.dispatch.trend.length}}" class="chart-canvas" canvas-id="dispatchTrend"></canvas>
        </block>
        <view wx:else class="analysis-detail-table">
          <view class="analysis-detail-head dispatch-trend-grid"><text>日期</text><text>有效派班</text><text>已完成</text><text>待完成</text></view>
          <view wx:for="{{model.dispatch.trend}}" wx:key="date" class="analysis-detail-row dispatch-trend-grid"><text>{{item.date}}</text><text class="blue">{{item.total}}</text><text class="green">{{item.finished}}</text><text class="orange">{{item.pending}}</text></view>
        </view>
        <view wx:if="{{!model.dispatch.trend.length}}" class="empty-inline">暂无趋势数据</view>
      </view>

      <view class="analysis-cta" data-type="dispatch" bindtap="openBusiness"><t-icon name="assignment" size="36rpx" color="#07965e" /><text>查看派班记录</text><t-icon class="cta-arrow" name="chevron-right" size="34rpx" color="#7b8491" /></view>
    </block>
  </view>
</view>
