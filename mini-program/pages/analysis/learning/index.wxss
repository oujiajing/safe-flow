@import "../../../styles/analysis.wxss";

.learning-kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.learning-kpi-card {
  height: 171rpx;
  padding: 28rpx 8rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 22rpx rgba(23, 32, 51, 0.06);
  color: #172033;
  font-size: 23rpx;
  text-align: center;
  box-sizing: border-box;
}

.learning-kpi-card > view { margin-top: 22rpx; white-space: nowrap; }
.learning-kpi-value { color: #1677e8; font-size: 47rpx; line-height: 1; font-weight: 500; }
.learning-kpi-unit { margin-left: 8rpx; color: #4b5563; font-size: 20rpx; }

.learning-analysis .analysis-section { margin-top: 18rpx; }
.learning-trend-card { min-height: 437rpx; }
.learning-trend-card .section-head { margin-bottom: 10rpx; }
.learning-trend-card .chart-canvas { width: 100%; height: 286rpx; }
.learning-chart-legend { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 16rpx; color: #4b5563; font-size: 22rpx; }

.learning-ranking-card { min-height: 280rpx; }
.learning-ranking-card .section-head { margin-bottom: 8rpx; }
.learning-rank-chart-row { display:grid; grid-template-columns:42rpx 150rpx 1fr 48rpx; align-items:center; gap:12rpx; min-height:68rpx; }
.learning-rank-index { width:34rpx; height:34rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:#e8f1ff; color:#1677e8; font-size:19rpx; }
.learning-rank-chart-row .bar-track { height:16rpx; }
.learning-rank-name { color: #172033; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.learning-rank-value { color: #1677e8; font-size: 31rpx; text-align: right; }
.learning-ranking-grid { grid-template-columns:.7fr 1.8fr 1fr; }
.learning-ranking-grid > text:nth-child(2) { text-align:left; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

.learning-category-card { min-height: 252rpx; }
.learning-category-card .section-head { margin-bottom: 20rpx; }
.learning-title-unit { margin-left: 8rpx; color: #4b5563; font-size: 21rpx; font-weight: 400; }
.learning-category-chart { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx 28rpx; }
.learning-category-chart-row { display:grid; grid-template-columns:48rpx 100rpx 1fr 48rpx; align-items:center; gap:10rpx; min-height:76rpx; }
.learning-category-chart-row > text:nth-child(2) { font-size:21rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.learning-category-chart-row .bar-track { height:14rpx; }
.learning-category-icon { width: 46rpx; height: 52rpx; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 46rpx; background: #07965e; }
.learning-category-icon.blue { background: #1677e8; }
.learning-category-icon.orange { background: #ff7100; }
.learning-category-icon.purple { background: #8b5cf6; }
.learning-category-icon.gray { background: #8b929c; }
.learning-category-value { color: #07965e; font-size: 27rpx; font-weight: 500; text-align:right; }
.learning-category-value.blue { color: #1677e8; }
.learning-category-value.orange { color: #ff7100; }
.learning-category-value.purple { color: #8b5cf6; }
.learning-category-value.gray { color: #8b929c; }
.learning-category-detail-grid { grid-template-columns:1.6fr 1fr; }
.learning-category-detail-grid > text:first-child { text-align:left; }
.learning-category-detail-grid .green { color:#07965e; }.learning-category-detail-grid .blue { color:#1677e8; }.learning-category-detail-grid .orange { color:#ff7100; }.learning-category-detail-grid .purple { color:#8b5cf6; }.learning-category-detail-grid .gray { color:#8b929c; }
.learning-trend-grid { grid-template-columns:1fr 1fr; }
.learning-trend-card .blue,.learning-ranking-card .blue { color:#1677e8; }

.learning-cta { min-height: 89rpx; margin-top: 32rpx; font-size: 31rpx; font-weight: 500; }
