page {
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  background: #f4f6f8;
}

.page {
  min-height: 100vh;
  padding: 0 0 40rpx;
  background: #f4f6f8;
  color: #172033;
  box-sizing: border-box;
}

.rectification-detail-page {
  --td-brand-color: #1f9d67;
  --td-brand-color-active: #0f8f5a;
  --td-brand-color-focus: #e8f7f0;
  --td-button-border-radius: 14rpx;
}

.rectification-state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.state-retry-btn {
  --td-button-primary-color: #1f9d67;
  --td-button-primary-border-color: #1f9d67;
  --td-button-border-radius: 999rpx;
}

.detail-card {
  margin: 0 20rpx 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(229, 232, 239, 0.9);
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(23, 32, 51, 0.06);
}

.detail-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.summary-card {
  margin: 0 0 18rpx;
  padding: 18rpx 22rpx 20rpx;
  border-radius: 16rpx;
}

.summary-card .detail-card-head {
  margin-bottom: 16rpx;
}

.summary-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 28rpx;
}

.summary-column {
  min-width: 0;
}

.summary-right {
  padding-left: 28rpx;
  border-left: 1rpx solid #e5e8ef;
}

.summary-row {
  display: grid;
  grid-template-columns: 102rpx minmax(0, 1fr);
  align-items: center;
  min-height: 46rpx;
  margin-bottom: 10rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-row > text:first-child {
  color: #697386;
  font-size: 24rpx;
  line-height: 1.35;
}

.summary-row > text:last-child {
  color: #172033;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.head-status-tag {
  --td-tag-medium-font-size: 24rpx;
  --td-tag-medium-height: 42rpx;
  --td-tag-border-radius: 12rpx;
}

.summary-status-tag {
  justify-self: start;
  --td-tag-small-font-size: 22rpx;
  --td-tag-small-height: 38rpx;
  --td-tag-border-radius: 8rpx;
}

.hazard-detail-card {
  padding: 24rpx 18rpx 22rpx;
  border-radius: 20rpx;
}

.hazard-detail-card .detail-card-head {
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.hazard-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.hazard-item {
  position: relative;
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
  min-height: 132rpx;
  padding: 26rpx 58rpx 24rpx 24rpx;
  border: 1rpx solid #e7ebf1;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.hazard-index {
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #1f9d67;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
  flex: 0 0 44rpx;
}

.hazard-content {
  min-width: 0;
  flex: 1;
}

.hazard-line {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  gap: 28rpx;
  align-items: center;
  margin-bottom: 18rpx;
}

.hazard-line:last-child {
  margin-bottom: 0;
}

.hazard-label {
  color: #697386;
  font-size: 28rpx;
  line-height: 1.35;
}

.hazard-value {
  color: #172033;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.4;
  word-break: break-all;
}

.hazard-desc {
  align-items: start;
}

.hazard-desc .hazard-value {
  line-height: 1.5;
}

.hazard-status-tag {
  justify-self: start;
  --td-tag-small-height: 42rpx;
  --td-tag-small-font-size: 27rpx;
  --td-tag-border-radius: 8rpx;
  --td-tag-primary-color: #1f9d67;
  --td-tag-primary-border-color: #1f9d67;
  --td-tag-primary-light-color: #ffffff;
}

.hazard-arrow {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #8a94a6;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

.section-empty {
  padding: 36rpx 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #8a94a6;
  font-size: 26rpx;
  text-align: center;
}

.after-photo-card {
  padding: 26rpx 26rpx 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 75, 0.08);
}

.after-photo-card .detail-card-head {
  margin-bottom: 18rpx;
  padding: 0;
  border: 0;
}

.after-photo-list {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding-bottom: 2rpx;
}

.after-photo-image {
  display: block;
  width: 152rpx;
  height: 128rpx;
  border-radius: 12rpx;
  background: #eef2f7;
  flex: 0 0 152rpx;
}

.closure-flow-card {
  padding: 26rpx 14rpx 26rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 75, 0.08);
}

.closure-flow-card .detail-card-head {
  margin-bottom: 22rpx;
  padding: 0;
  border: 0;
}

.closure-flow-timeline {
  position: relative;
}

.closure-flow-timeline::before {
  display: none;
}

.closure-flow-step {
  position: relative;
  display: grid;
  grid-template-columns: 160rpx minmax(0, 1fr);
  gap: 24rpx;
  padding-bottom: 28rpx;
}

.closure-flow-step::before {
  position: absolute;
  z-index: 0;
  left: 28rpx;
  top: 58rpx;
  bottom: 0;
  width: 2rpx;
  background: #b7ead4;
  content: "";
}

.closure-flow-step:last-child {
  padding-bottom: 0;
}

.closure-flow-step:last-child::before {
  display: none;
}

.closure-flow-side {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 58rpx minmax(0, 1fr);
  grid-template-rows: auto auto;
  column-gap: 14rpx;
  align-items: start;
  align-self: start;
  min-width: 0;
}

.closure-flow-icon {
  position: relative;
  grid-row: 1 / span 2;
  width: 58rpx;
  height: 58rpx;
  border: 2rpx solid #17a86b;
  border-radius: 50%;
  background: #ffffff;
  color: #17a86b;
  box-sizing: border-box;
}

.closure-flow-icon::after {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}

.closure-flow-icon-eye::after {
  content: "◎";
}

.closure-flow-icon-doc::after {
  content: "▤";
}

.closure-flow-icon-upload::after {
  content: "☁";
}

.closure-flow-icon-user::after {
  content: "●";
}

.closure-flow-icon-check::after {
  content: "✓";
}

.closure-flow-icon-close {
  border-color: #c9ced6;
  color: #8d95a3;
}

.closure-flow-icon-close::after {
  content: "×";
}

.closure-flow-side-title {
  margin-top: 6rpx;
  max-width: 100%;
  color: #182033;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-align: left;
  white-space: nowrap;
}

.closure-flow-time {
  margin-top: 2rpx;
  color: #6f7785;
  font-size: 21rpx;
  line-height: 28rpx;
  text-align: left;
  white-space: nowrap;
}

.closure-flow-panel {
  min-width: 0;
  margin-top: 0;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e9ef;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(20, 35, 55, 0.06);
  box-sizing: border-box;
}

.closure-flow-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.closure-flow-row-two {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.closure-flow-row:last-child {
  margin-bottom: 0;
}

.closure-flow-field {
  display: grid;
  grid-template-columns: auto minmax(48rpx, 1fr);
  min-width: 0;
  color: #182033;
  font-size: 22rpx;
  line-height: 32rpx;
}

.closure-flow-field-half + .closure-flow-field-half {
  padding-left: 12rpx;
  border-left: 1rpx solid #edf1f5;
}

.closure-flow-label {
  min-width: 0;
  max-width: 150rpx;
  color: #182033;
  font-weight: 900;
  word-break: keep-all;
}

.closure-flow-value {
  min-width: 0;
  color: #3d4654;
  word-break: normal;
  overflow-wrap: break-word;
}

.closure-flow-value-success {
  color: #13a66b;
  font-weight: 900;
}

.closure-flow-photos {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
  padding-left: 0;
}

.closure-flow-photo {
  display: block;
  width: 104rpx;
  height: 104rpx;
  border-radius: 8rpx;
  background: #eef2f7;
  flex: 0 0 112rpx;
}

.closure-flow-step-cancel .closure-flow-side-title,
.closure-flow-step-cancel .closure-flow-time {
  color: #6f7785;
}

.flow-log-card {
  padding: 26rpx 22rpx 24rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 75, 0.08);
}

.flow-log-card .detail-card-head {
  margin-bottom: 20rpx;
  padding: 0;
  border: 0;
}

.flow-log-table {
  overflow: hidden;
  border: 1rpx solid #dfe4eb;
  border-radius: 14rpx;
  background: #ffffff;
}

.flow-log-tr {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr 1.75fr 1.45fr;
  min-height: 66rpx;
  border-bottom: 1rpx solid #dfe4eb;
}

.flow-log-tr:last-child {
  border-bottom: 0;
}

.flow-log-head-row {
  min-height: 72rpx;
  background: #ffffff;
}

.flow-log-th,
.flow-log-td {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 12rpx 16rpx;
  border-right: 1rpx solid #dfe4eb;
  color: #182033;
  font-size: 24rpx;
  line-height: 34rpx;
  box-sizing: border-box;
  word-break: break-all;
}

.flow-log-th:last-child,
.flow-log-td:last-child {
  border-right: 0;
}

.flow-log-th {
  font-weight: 900;
}

.flow-log-td {
  font-weight: 500;
}

.flow-log-th:nth-child(-n + 3),
.flow-log-td:nth-child(-n + 3) {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flow-detail-card {
  padding: 26rpx 26rpx 28rpx;
  border-radius: 20rpx;
}

.flow-detail-card .detail-card-head {
  margin-bottom: 22rpx;
}

.flow-timeline {
  position: relative;
  padding: 0 0 0 4rpx;
}

.flow-timeline::before {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  bottom: 24rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: #9fe5c8;
  content: "";
}

.flow-item {
  position: relative;
  display: flex;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.flow-item:last-child {
  padding-bottom: 0;
}

.flow-node {
  position: relative;
  z-index: 1;
  width: 32rpx;
  height: 32rpx;
  margin-top: 32rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #18a96b;
  box-shadow: 0 0 0 3rpx rgba(24, 169, 107, 0.2);
  flex: 0 0 32rpx;
}

.flow-node::after {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0b8f57;
  transform: translate(-50%, -50%);
  content: "";
}

.flow-item-current .flow-node {
  border-color: #18a96b;
  background: #ffffff;
  box-shadow: 0 0 0 3rpx rgba(24, 169, 107, 0.16);
}

.flow-item-current .flow-node::after {
  background: #18a96b;
}

.flow-content {
  position: relative;
  min-width: 0;
  padding: 20rpx 24rpx 18rpx 28rpx;
  border: 1rpx solid #edf1f5;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(20, 35, 55, 0.1);
  flex: 1;
}

.flow-content::before {
  position: absolute;
  left: -12rpx;
  top: 32rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 1rpx solid #edf1f5;
  border-bottom: 1rpx solid #edf1f5;
  background: #ffffff;
  box-shadow: -3rpx 4rpx 8rpx rgba(20, 35, 55, 0.04);
  transform: rotate(45deg);
  content: "";
}

.flow-card-head {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.flow-title {
  min-width: 0;
  color: #172033;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 38rpx;
  word-break: break-all;
}

.flow-time {
  flex: 0 0 auto;
  color: #6f7785;
  font-size: 25rpx;
  line-height: 38rpx;
  white-space: nowrap;
}

.flow-line {
  display: flex;
  max-width: 100%;
  min-width: 0;
  color: #606b7a;
  font-size: 25rpx;
  line-height: 36rpx;
}

.flow-line text:first-child {
  flex: 0 0 auto;
}

.flow-line text:last-child {
  min-width: 0;
  word-break: break-all;
}

.action-card {
  padding-bottom: 28rpx;
}

.issue-action-card {
  padding: 24rpx 18rpx 26rpx;
  border-radius: 20rpx;
}

.issue-action-card .detail-card-head {
  margin-bottom: 18rpx;
}

.form-cell {
  display: grid;
  grid-template-columns: 214rpx 1fr;
  gap: 18rpx;
  align-items: center;
  min-height: 88rpx;
  border-top: 1rpx solid #e7ebf1;
}

.form-cell > text:first-child {
  color: #4b5563;
  font-size: 25rpx;
  font-weight: 600;
}

.form-cell.required > text:first-child::before,
.picker-cell.required > text:first-child::before {
  margin-right: 6rpx;
  color: #f04438;
  content: "*";
}

.form-cell input,
.form-cell textarea {
  width: 100%;
  min-height: 64rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #172033;
  font-size: 25rpx;
  box-sizing: border-box;
}

.form-cell textarea {
  min-height: 140rpx;
  line-height: 1.5;
}

.form-cell-block {
  align-items: start;
  padding: 16rpx 0;
}

.form-cell-block > text:first-child {
  padding-top: 16rpx;
}

.issue-action-card .form-cell {
  position: relative;
  grid-template-columns: 210rpx minmax(0, 1fr);
  gap: 16rpx;
  min-height: 74rpx;
  border-top: 0;
}

.issue-action-card .form-cell > text:first-child {
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
  text-align: left;
  white-space: nowrap;
}

.issue-action-card .form-cell:not(.required) > text:first-child::before {
  margin-right: 6rpx;
  color: transparent;
  content: "*";
}

.issue-action-card .form-cell input,
.issue-action-card .form-cell textarea {
  width: 100%;
  min-height: 58rpx;
  padding: 11rpx 54rpx 11rpx 18rpx;
  border-color: #e4e9f0;
  border-radius: 10rpx;
  color: #172033;
  font-size: 24rpx;
  line-height: 34rpx;
}

.issue-action-card .form-cell textarea {
  width: 100%;
  min-height: 86rpx;
  height: 86rpx;
  max-height: 86rpx;
  padding: 10rpx 20rpx 10rpx 18rpx;
  line-height: 34rpx;
}

.issue-action-card .issue-requirement-input {
  min-height: 86rpx;
  height: 86rpx;
  max-height: 86rpx;
  box-sizing: border-box;
}

.issue-action-card .form-cell-block {
  min-height: 104rpx;
  padding: 6rpx 0;
}

.issue-action-card .form-cell-block > text:first-child {
  padding-top: 12rpx;
}

.issue-action-card .picker-cell {
  min-height: 66rpx;
}

.issue-action-card .picker-cell text:last-child {
  width: 100%;
  min-height: 58rpx;
  padding: 11rpx 54rpx 11rpx 18rpx;
  border-color: #e4e9f0;
  border-radius: 10rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.issue-action-card .form-cell::after,
.issue-action-card .picker-cell text:last-child::after {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #9aa3af;
  font-size: 28rpx;
  line-height: 1;
}

.issue-action-card .form-cell::after {
  content: "";
}

.issue-action-card .issue-user-cell::after {
  content: "⌾";
}

.issue-action-card .issue-dept-cell::after {
  content: "▥";
}

.issue-action-card .issue-requirement-cell::after {
  content: "";
}

.issue-action-card .picker-cell text:last-child::after {
  right: 18rpx;
}

.issue-action-card .issue-date-cell text:last-child::after {
  content: "□";
}

.issue-action-card .issue-time-cell text:last-child::after {
  content: "◷";
}

.issue-action-card .primary-action-btn {
  display: block;
  width: 92%;
  margin: 18rpx auto 0;
  --td-button-width: 92%;
  --td-button-large-height: 76rpx;
  --td-button-border-radius: 10rpx;
  font-size: 30rpx;
}

.picker-cell {
  padding: 0;
}

.picker-cell text:last-child {
  position: relative;
  min-height: 64rpx;
  padding: 14rpx 48rpx 14rpx 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 25rpx;
  box-sizing: border-box;
}

.picker-cell text:last-child::after {
  position: absolute;
  right: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #a0a7b5;
  content: "›";
}

.picker-value {
  color: #172033;
}

.picker-placeholder {
  color: #a0a7b5;
}

.primary-action-btn,
.danger-action-btn {
  margin-top: 24rpx;
  --td-button-large-height: 82rpx;
  --td-button-border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.primary-action-btn {
  --td-button-primary-bg-color: #1f9d67;
  --td-button-primary-border-color: #1f9d67;
  --td-button-primary-active-bg-color: #0f8f5a;
  --td-button-primary-active-border-color: #0f8f5a;
}

.danger-action-btn {
  --td-button-danger-bg-color: #f04438;
  --td-button-danger-border-color: #f04438;
}

.upload-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx dashed #c8d0dc;
  border-radius: 14rpx;
  color: #697386;
  font-size: 25rpx;
  box-sizing: border-box;
}

.upload-add {
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid #d8dee8;
  border-radius: 12rpx;
  color: #697386;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 62rpx;
  text-align: center;
}

.photo-preview-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.rectification-photo-preview {
  display: block;
  width: 156rpx;
  height: 156rpx;
  border-radius: 12rpx;
  background: #eef2f7;
}

.rectify-submit-card {
  padding: 30rpx 28rpx 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 75, 0.08);
}

.rectify-submit-card .detail-card-head {
  margin-bottom: 26rpx;
  padding: 0;
  border: 0;
}

.rectify-field {
  margin-top: 0;
}

.rectify-field-label {
  color: #2d3748;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.rectify-field-label > text:first-child {
  margin-left: 8rpx;
  color: #ff4d4f;
}

.rectify-upload-limit {
  margin-left: 14rpx;
  color: #9aa3b2 !important;
  font-size: 22rpx;
  font-weight: 700;
}

.rectify-textarea-wrap {
  position: relative;
  margin-top: 18rpx;
}

.rectify-description-input {
  width: 100%;
  height: 142rpx;
  min-height: 142rpx;
  max-height: 142rpx;
  padding: 22rpx 26rpx 44rpx;
  border: 2rpx solid #e3e7ee;
  border-radius: 14rpx;
  background: #ffffff;
  color: #172033;
  font-size: 26rpx;
  line-height: 38rpx;
  box-sizing: border-box;
}

.rectify-description-input::placeholder {
  color: #b8bfca;
}

.rectify-count {
  position: absolute;
  right: 26rpx;
  bottom: 18rpx;
  color: #9aa3b2;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.rectify-upload-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
}

.rectify-selected-count {
  flex: 0 0 auto;
  color: #13a66b;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.rectify-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
}

.rectify-photo-item,
.rectify-photo-add {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.rectify-photo-item {
  position: relative;
  overflow: hidden;
  background: #eef2f7;
}

.rectify-photo-item::after {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(31, 41, 55, 0.76);
  color: #ffffff;
  content: "×";
  font-size: 30rpx;
  font-weight: 300;
  line-height: 31rpx;
  text-align: center;
}

.rectify-submit-card .rectification-photo-preview {
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
}

.rectify-photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d8dde6;
  background: #ffffff;
  color: #8d95a3;
}

.rectify-photo-plus {
  color: #7f8896;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 58rpx;
}

.rectify-photo-add-text {
  margin-top: 10rpx;
  color: #8d95a3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.rectify-upload-tip {
  margin-top: 16rpx;
  color: #a4abb7;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.rectify-submit-card .primary-action-btn {
  display: block;
  width: 100%;
  margin-top: 28rpx;
  --td-button-width: 100%;
  --td-button-large-height: 86rpx;
  --td-button-border-radius: 12rpx;
  --td-button-primary-bg-color: #13a66b;
  --td-button-primary-border-color: #13a66b;
  --td-button-primary-active-bg-color: #078f59;
  --td-button-primary-active-border-color: #078f59;
  font-size: 32rpx;
  font-weight: 900;
}

.accept-action-row {
  display: flex;
  margin-top: 24rpx;
}

.accept-btn {
  flex: 1;
  --td-button-large-height: 76rpx;
  --td-button-border-radius: 12rpx;
  --td-button-primary-bg-color: #1f9d67;
  --td-button-primary-border-color: #1f9d67;
  font-weight: 900;
}

.danger-card {
  border-color: rgba(240, 68, 56, 0.18);
}

.acceptance-process-card {
  padding: 26rpx 22rpx 28rpx;
  border: 0;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(24, 39, 75, 0.08);
  overflow: hidden;
}

.acceptance-process-card .detail-card-head {
  margin-bottom: 24rpx;
  padding: 0;
  border: 0;
}

.acceptance-form-row {
  display: grid;
  grid-template-columns: 152rpx minmax(0, 1fr);
  gap: 10rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.acceptance-textarea-row {
  align-items: start;
}

.acceptance-label {
  color: #2d3748;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 36rpx;
  word-break: normal;
}

.acceptance-input {
  width: 100%;
  height: 66rpx;
  min-height: 66rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e3e7ee;
  border-radius: 10rpx;
  background: #ffffff;
  color: #172033;
  font-size: 25rpx;
  box-sizing: border-box;
}

.acceptance-input::placeholder,
.acceptance-textarea::placeholder {
  color: #b8bfca;
}

.acceptance-textarea-wrap {
  position: relative;
  min-width: 0;
}

.acceptance-textarea {
  width: 100%;
  height: 106rpx;
  min-height: 106rpx;
  max-height: 106rpx;
  padding: 18rpx 22rpx 38rpx;
  border: 2rpx solid #e3e7ee;
  border-radius: 10rpx;
  background: #ffffff;
  color: #172033;
  font-size: 25rpx;
  line-height: 36rpx;
  box-sizing: border-box;
}

.acceptance-count {
  position: absolute;
  right: 20rpx;
  bottom: 14rpx;
  color: #9aa3b2;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.acceptance-action-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
  margin-top: 18rpx;
  box-sizing: border-box;
}

.acceptance-action-item {
  min-width: 0;
  flex: 1;
}

.acceptance-pass-btn,
.acceptance-reject-btn {
  display: block;
  width: 100%;
  --td-button-width: 100%;
  --td-button-large-height: 80rpx;
  --td-button-border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.acceptance-pass-btn {
  --td-button-primary-bg-color: #13a66b;
  --td-button-primary-border-color: #13a66b;
  --td-button-primary-active-bg-color: #078f59;
  --td-button-primary-active-border-color: #078f59;
}

.acceptance-reject-btn {
  --td-button-danger-bg-color: #f43f3a;
  --td-button-danger-border-color: #f43f3a;
  --td-button-danger-active-bg-color: #dc2626;
  --td-button-danger-active-border-color: #dc2626;
}
