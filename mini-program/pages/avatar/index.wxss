page {
  background: #f7f7f7;
}

.avatar-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: #242a31;
  background: #f7f7f7;
}

.avatar-nav {
  flex: 0 0 auto;
  background: #ffffff;
}

.avatar-status-bar {
  width: 100%;
}

.avatar-nav-bar {
  display: flex;
  align-items: center;
}

.avatar-nav-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 100%;
}

.avatar-nav-action--pressed {
  background: #f2f4f3;
}

.avatar-nav-title {
  margin-left: 4rpx;
  color: #242a31;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 54rpx;
  white-space: nowrap;
}

.avatar-nav-space {
  flex: 1;
  height: 100%;
}

.avatar-preview-panel {
  display: flex;
  flex: 0 0 750rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #e9e9e9;
}

.avatar-preview-image {
  width: 540rpx;
  height: 540rpx;
  border-radius: 36rpx;
}

.avatar-preview-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 540rpx;
  height: 540rpx;
}

.avatar-page-spacer {
  flex: 1 1 160rpx;
  min-height: 100rpx;
}

.avatar-actions {
  flex: 0 0 auto;
  border-top: 1rpx solid #e5e5e5;
  background: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
}

.avatar-action-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  border-bottom: 1rpx solid #e8e8e8;
  color: #242a31;
  font-size: 34rpx;
  line-height: 48rpx;
}

.avatar-action-row:last-child {
  border-bottom: 0;
}

.avatar-action-row--pressed {
  background: #f2f4f3;
}
