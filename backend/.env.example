# PostgreSQL
POSTGRES_IMAGE=registry-1.docker.io/pgvector/pgvector:pg16
POSTGRES_DB=pingan_banzu_verify
POSTGRES_USER=pingan
POSTGRES_PASSWORD=pingan
POSTGRES_PORT=15433
PINGAN_DB_URL=jdbc:postgresql://localhost:15433/pingan_banzu_verify
PINGAN_DB_USERNAME=pingan
PINGAN_DB_PASSWORD=pingan

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PINGAN_STORAGE_PROVIDER=minio
PINGAN_MINIO_ENDPOINT=http://localhost:9000
PINGAN_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
PINGAN_MINIO_BUCKET=pingan-banzu
PINGAN_MINIO_ACCESS_KEY=minioadmin
PINGAN_MINIO_SECRET_KEY=minioadmin
PINGAN_MINIO_REGION=us-east-1
PINGAN_MINIO_PRESIGNED_URL_MINUTES=15

# Application
PINGAN_JWT_SECRET=replace-with-a-strong-secret-at-least-32-bytes
